                 b_RelationAsSet_ExplicitVarSizeWithMarker_Values_1[1] = q17_1 /\
                 b_RelationAsSet_ExplicitVarSizeWithMarker_Values_2[1] < q17_2;
                     int(1..3)])
            ->
            sum([toInt(a_RelationAsMatrix[q32_1, q32_2]) *
                 catchUndef(toInt(q32_1 = b_RelationAsSet_ExplicitVarSizeWithMarker_Values_1[1] /\
                                  q32_2 = b_RelationAsSet_ExplicitVarSizeWithMarker_Values_2[1]),
