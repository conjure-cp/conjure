language ESSENCE' 1.0

find a_Occurrence: matrix indexed by [int(1..2)] of bool
find b_ExplicitVarSizeWithFlags_Flags: matrix indexed by [int(1..2)] of bool
find b_ExplicitVarSizeWithFlags_Values: matrix indexed by [int(1..2)] of int(1..2)
branching on [a_Occurrence, b_ExplicitVarSizeWithFlags_Flags, b_ExplicitVarSizeWithFlags_Values]
such that
    and([a_Occurrence[q7] ->
         or([b_ExplicitVarSizeWithFlags_Flags[q9] /\ b_ExplicitVarSizeWithFlags_Values[q9] = q7 | q9 : int(1..2)])
             | q7 : int(1..2)])
    /\
    and([b_ExplicitVarSizeWithFlags_Flags[q11] -> a_Occurrence[b_ExplicitVarSizeWithFlags_Values[q11]]
             | q11 : int(1..2)])
    \/
    (or([a_Occurrence[q12] /\
         (toInt(a_Occurrence[q12]) <
          toInt(or([b_ExplicitVarSizeWithFlags_Flags[q25] /\ b_ExplicitVarSizeWithFlags_Values[q25] = q12
                        | q25 : int(1..2)]))
          /\
          (and([a_Occurrence[q13] ->
                toInt(a_Occurrence[q13]) =
                toInt(or([b_ExplicitVarSizeWithFlags_Flags[q31] /\ b_ExplicitVarSizeWithFlags_Values[q31] = q13
                              | q31 : int(1..2)]))
                    | q13 : int(1..2), q13 < q12])
           /\
           and([and([b_ExplicitVarSizeWithFlags_Flags[q26],
                     !or([a_Occurrence[q29] /\ q29 = b_ExplicitVarSizeWithFlags_Values[q26] | q29 : int(1..2)]),
                     b_ExplicitVarSizeWithFlags_Values[q26] < q12;
                         int(1..3)])
                ->
                toInt(a_Occurrence[b_ExplicitVarSizeWithFlags_Values[q26]]) =
                toInt(or([b_ExplicitVarSizeWithFlags_Flags[q28] /\
                          b_ExplicitVarSizeWithFlags_Values[q28] = b_ExplicitVarSizeWithFlags_Values[q26]
                              | q28 : int(1..2)]))
                    | q26 : int(1..2)])))
             | q12 : int(1..2)])
     \/
     or([b_ExplicitVarSizeWithFlags_Flags[q14] /\
         !or([a_Occurrence[q23] /\ q23 = b_ExplicitVarSizeWithFlags_Values[q14] | q23 : int(1..2)])
         /\
         (toInt(a_Occurrence[b_ExplicitVarSizeWithFlags_Values[q14]]) <
          toInt(or([b_ExplicitVarSizeWithFlags_Flags[q16] /\
                    b_ExplicitVarSizeWithFlags_Values[q16] = b_ExplicitVarSizeWithFlags_Values[q14]
                        | q16 : int(1..2)]))
          /\
          (and([a_Occurrence[q13] /\ q13 < b_ExplicitVarSizeWithFlags_Values[q14] ->
                toInt(a_Occurrence[q13]) =
                toInt(or([b_ExplicitVarSizeWithFlags_Flags[q22] /\ b_ExplicitVarSizeWithFlags_Values[q22] = q13
                              | q22 : int(1..2)]))
                    | q13 : int(1..2)])
           /\
           and([and([b_ExplicitVarSizeWithFlags_Flags[q17],
                     !or([a_Occurrence[q20] /\ q20 = b_ExplicitVarSizeWithFlags_Values[q17] | q20 : int(1..2)]),
                     b_ExplicitVarSizeWithFlags_Values[q17] < b_ExplicitVarSizeWithFlags_Values[q14];
                         int(1..3)])
                ->
                toInt(a_Occurrence[b_ExplicitVarSizeWithFlags_Values[q17]]) =
                toInt(or([b_ExplicitVarSizeWithFlags_Flags[q19] /\
                          b_ExplicitVarSizeWithFlags_Values[q19] = b_ExplicitVarSizeWithFlags_Values[q17]
                              | q19 : int(1..2)]))
                    | q17 : int(1..2)])))
             | q14 : int(1..2)])),
    sum([toInt(a_Occurrence[q1]) | q1 : int(1..2)]) <= 2,
    b_ExplicitVarSizeWithFlags_Flags[2] -> b_ExplicitVarSizeWithFlags_Values[1] < b_ExplicitVarSizeWithFlags_Values[2],
    and([b_ExplicitVarSizeWithFlags_Flags[q3] = false -> b_ExplicitVarSizeWithFlags_Values[q3] = 1 | q3 : int(1..2)]),
    b_ExplicitVarSizeWithFlags_Flags[2] -> b_ExplicitVarSizeWithFlags_Flags[1],
    sum([toInt(b_ExplicitVarSizeWithFlags_Flags[q5]) | q5 : int(1..2)]) <= 2

