language ESSENCE' 1.0

find a_ExplicitVarSizeWithFlags_Flags: matrix indexed by [int(1..2)] of bool
find a_ExplicitVarSizeWithFlags_Values: matrix indexed by [int(1..2)] of int(1..2)
find b_ExplicitVarSizeWithFlags_Flags: matrix indexed by [int(1..2)] of bool
find b_ExplicitVarSizeWithFlags_Values: matrix indexed by [int(1..2)] of int(1..2)
branching on
    [a_ExplicitVarSizeWithFlags_Flags, a_ExplicitVarSizeWithFlags_Values, b_ExplicitVarSizeWithFlags_Flags,
