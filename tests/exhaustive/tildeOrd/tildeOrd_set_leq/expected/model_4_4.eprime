    a_ExplicitVarSizeWithFlags_Flags[2] -> a_ExplicitVarSizeWithFlags_Flags[1],
    sum([toInt(a_ExplicitVarSizeWithFlags_Flags[q4]) | q4 : int(1..2)]) <= 2,
    b_ExplicitVarSizeWithFlags_Flags[2] -> b_ExplicitVarSizeWithFlags_Values[1] < b_ExplicitVarSizeWithFlags_Values[2],
    and([b_ExplicitVarSizeWithFlags_Flags[q7] = false -> b_ExplicitVarSizeWithFlags_Values[q7] = 1 | q7 : int(1..2)]),
