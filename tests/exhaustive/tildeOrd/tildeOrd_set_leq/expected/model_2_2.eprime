language ESSENCE' 1.0

find a_ExplicitVarSizeWithDummy: matrix indexed by [int(1..2)] of int(1..3)
find b_ExplicitVarSizeWithDummy: matrix indexed by [int(1..2)] of int(1..3)
branching on [a_ExplicitVarSizeWithDummy, b_ExplicitVarSizeWithDummy]
such that
    b_ExplicitVarSizeWithDummy <=lex a_ExplicitVarSizeWithDummy,
    a_ExplicitVarSizeWithDummy[1] < a_ExplicitVarSizeWithDummy[2] \/ a_ExplicitVarSizeWithDummy[1] = 3,
    a_ExplicitVarSizeWithDummy[1] = 3 -> a_ExplicitVarSizeWithDummy[2] = 3,
    sum([toInt(a_ExplicitVarSizeWithDummy[q3] != 3) | q3 : int(1..2)]) <= 2,
    b_ExplicitVarSizeWithDummy[1] < b_ExplicitVarSizeWithDummy[2] \/ b_ExplicitVarSizeWithDummy[1] = 3,
    b_ExplicitVarSizeWithDummy[1] = 3 -> b_ExplicitVarSizeWithDummy[2] = 3,
    sum([toInt(b_ExplicitVarSizeWithDummy[q7] != 3) | q7 : int(1..2)]) <= 2

