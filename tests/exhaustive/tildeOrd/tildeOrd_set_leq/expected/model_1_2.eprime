language ESSENCE' 1.0

find a_Occurrence: matrix indexed by [int(1..2)] of bool
find b_ExplicitVarSizeWithDummy: matrix indexed by [int(1..2)] of int(1..3)
branching on [a_Occurrence, b_ExplicitVarSizeWithDummy]
such that
    and([a_Occurrence[q6] ->
         or([b_ExplicitVarSizeWithDummy[q8] != 3 /\ b_ExplicitVarSizeWithDummy[q8] = q6 | q8 : int(1..2)])
             | q6 : int(1..2)])
    /\ and([b_ExplicitVarSizeWithDummy[q10] != 3 -> a_Occurrence[b_ExplicitVarSizeWithDummy[q10]] | q10 : int(1..2)])
    \/
    (or([a_Occurrence[q11] /\
         (toInt(a_Occurrence[q11]) <
          toInt(or([b_ExplicitVarSizeWithDummy[q24] != 3 /\ b_ExplicitVarSizeWithDummy[q24] = q11 | q24 : int(1..2)]))
          /\
          (and([a_Occurrence[q12] ->
                toInt(a_Occurrence[q12]) =
                toInt(or([b_ExplicitVarSizeWithDummy[q30] != 3 /\ b_ExplicitVarSizeWithDummy[q30] = q12
                              | q30 : int(1..2)]))
                    | q12 : int(1..2), q12 < q11])
           /\
           and([and([b_ExplicitVarSizeWithDummy[q25] != 3,
                     !or([a_Occurrence[q26] /\ q26 = b_ExplicitVarSizeWithDummy[q25] | q26 : int(1..2)]),
                     b_ExplicitVarSizeWithDummy[q25] < q11;
                         int(1..3)])
                ->
                toInt(a_Occurrence[b_ExplicitVarSizeWithDummy[q25]]) =
                toInt(or([b_ExplicitVarSizeWithDummy[q28] != 3 /\
                          b_ExplicitVarSizeWithDummy[q28] = b_ExplicitVarSizeWithDummy[q25]
                              | q28 : int(1..2)]))
                    | q25 : int(1..2)])))
             | q11 : int(1..2)])
     \/
     or([b_ExplicitVarSizeWithDummy[q13] != 3 /\
         !or([a_Occurrence[q14] /\ q14 = b_ExplicitVarSizeWithDummy[q13] | q14 : int(1..2)])
         /\
         (toInt(a_Occurrence[b_ExplicitVarSizeWithDummy[q13]]) <
          toInt(or([b_ExplicitVarSizeWithDummy[q16] != 3 /\
                    b_ExplicitVarSizeWithDummy[q16] = b_ExplicitVarSizeWithDummy[q13]
                        | q16 : int(1..2)]))
          /\
          (and([a_Occurrence[q12] /\ q12 < b_ExplicitVarSizeWithDummy[q13] ->
                toInt(a_Occurrence[q12]) =
                toInt(or([b_ExplicitVarSizeWithDummy[q22] != 3 /\ b_ExplicitVarSizeWithDummy[q22] = q12
                              | q22 : int(1..2)]))
                    | q12 : int(1..2)])
           /\
           and([and([b_ExplicitVarSizeWithDummy[q17] != 3,
                     !or([a_Occurrence[q18] /\ q18 = b_ExplicitVarSizeWithDummy[q17] | q18 : int(1..2)]),
                     b_ExplicitVarSizeWithDummy[q17] < b_ExplicitVarSizeWithDummy[q13];
                         int(1..3)])
                ->
                toInt(a_Occurrence[b_ExplicitVarSizeWithDummy[q17]]) =
                toInt(or([b_ExplicitVarSizeWithDummy[q20] != 3 /\
                          b_ExplicitVarSizeWithDummy[q20] = b_ExplicitVarSizeWithDummy[q17]
                              | q20 : int(1..2)]))
                    | q17 : int(1..2)])))
             | q13 : int(1..2)])),
    sum([toInt(a_Occurrence[q1]) | q1 : int(1..2)]) <= 2,
    b_ExplicitVarSizeWithDummy[1] < b_ExplicitVarSizeWithDummy[2] \/ b_ExplicitVarSizeWithDummy[1] = 3,
    b_ExplicitVarSizeWithDummy[1] = 3 -> b_ExplicitVarSizeWithDummy[2] = 3,
    sum([toInt(b_ExplicitVarSizeWithDummy[q4] != 3) | q4 : int(1..2)]) <= 2

