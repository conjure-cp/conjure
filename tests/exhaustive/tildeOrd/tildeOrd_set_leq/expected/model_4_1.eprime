language ESSENCE' 1.0

find a_ExplicitVarSizeWithFlags_Flags: matrix indexed by [int(1..2)] of bool
find a_ExplicitVarSizeWithFlags_Values: matrix indexed by [int(1..2)] of int(1..2)
find b_Occurrence: matrix indexed by [int(1..2)] of bool
branching on [a_ExplicitVarSizeWithFlags_Flags, a_ExplicitVarSizeWithFlags_Values, b_Occurrence]
such that
    and([a_ExplicitVarSizeWithFlags_Flags[q8] -> b_Occurrence[a_ExplicitVarSizeWithFlags_Values[q8]] | q8 : int(1..2)])
    /\
    and([b_Occurrence[q9] ->
         or([a_ExplicitVarSizeWithFlags_Flags[q11] /\ a_ExplicitVarSizeWithFlags_Values[q11] = q9 | q11 : int(1..2)])
             | q9 : int(1..2)])
    \/
    (or([a_ExplicitVarSizeWithFlags_Flags[q14] /\
         (toInt(or([a_ExplicitVarSizeWithFlags_Flags[q27] /\
                    a_ExplicitVarSizeWithFlags_Values[q27] = a_ExplicitVarSizeWithFlags_Values[q14]
                        | q27 : int(1..2)]))
          < toInt(b_Occurrence[a_ExplicitVarSizeWithFlags_Values[q14]])
          /\
          (and([a_ExplicitVarSizeWithFlags_Flags[q28] /\
                a_ExplicitVarSizeWithFlags_Values[q28] < a_ExplicitVarSizeWithFlags_Values[q14]
                ->
                toInt(or([a_ExplicitVarSizeWithFlags_Flags[q34] /\
                          a_ExplicitVarSizeWithFlags_Values[q34] = a_ExplicitVarSizeWithFlags_Values[q28]
                              | q34 : int(1..2)]))
                = toInt(b_Occurrence[a_ExplicitVarSizeWithFlags_Values[q28]])
                    | q28 : int(1..2)])
           /\
           and([and([b_Occurrence[q13],
                     !or([a_ExplicitVarSizeWithFlags_Flags[q32] /\ a_ExplicitVarSizeWithFlags_Values[q32] = q13
                              | q32 : int(1..2)]),
                     q13 < a_ExplicitVarSizeWithFlags_Values[q14];
                         int(1..3)])
                ->
                toInt(or([a_ExplicitVarSizeWithFlags_Flags[q30] /\ a_ExplicitVarSizeWithFlags_Values[q30] = q13
                              | q30 : int(1..2)]))
                = toInt(b_Occurrence[q13])
                    | q13 : int(1..2)])))
             | q14 : int(1..2)])
     \/
     or([b_Occurrence[q12] /\
         !or([a_ExplicitVarSizeWithFlags_Flags[q25] /\ a_ExplicitVarSizeWithFlags_Values[q25] = q12 | q25 : int(1..2)])
         /\
         (toInt(or([a_ExplicitVarSizeWithFlags_Flags[q16] /\ a_ExplicitVarSizeWithFlags_Values[q16] = q12
                        | q16 : int(1..2)]))
          < toInt(b_Occurrence[q12])
          /\
          (and([a_ExplicitVarSizeWithFlags_Flags[q17] /\ a_ExplicitVarSizeWithFlags_Values[q17] < q12 ->
                toInt(or([a_ExplicitVarSizeWithFlags_Flags[q23] /\
                          a_ExplicitVarSizeWithFlags_Values[q23] = a_ExplicitVarSizeWithFlags_Values[q17]
                              | q23 : int(1..2)]))
                = toInt(b_Occurrence[a_ExplicitVarSizeWithFlags_Values[q17]])
                    | q17 : int(1..2)])
           /\
           and([b_Occurrence[q13] /\
                !or([a_ExplicitVarSizeWithFlags_Flags[q21] /\ a_ExplicitVarSizeWithFlags_Values[q21] = q13
                         | q21 : int(1..2)])
                ->
                toInt(or([a_ExplicitVarSizeWithFlags_Flags[q19] /\ a_ExplicitVarSizeWithFlags_Values[q19] = q13
                              | q19 : int(1..2)]))
                = toInt(b_Occurrence[q13])
                    | q13 : int(1..2), q13 < q12])))
             | q12 : int(1..2)])),
    a_ExplicitVarSizeWithFlags_Flags[2] -> a_ExplicitVarSizeWithFlags_Values[1] < a_ExplicitVarSizeWithFlags_Values[2],
    and([a_ExplicitVarSizeWithFlags_Flags[q2] = false -> a_ExplicitVarSizeWithFlags_Values[q2] = 1 | q2 : int(1..2)]),
    a_ExplicitVarSizeWithFlags_Flags[2] -> a_ExplicitVarSizeWithFlags_Flags[1],
    sum([toInt(a_ExplicitVarSizeWithFlags_Flags[q4]) | q4 : int(1..2)]) <= 2,
    sum([toInt(b_Occurrence[q6]) | q6 : int(1..2)]) <= 2

