language ESSENCE' 1.0

find a_ExplicitVarSizeWithMarker_Marker: int(0..2)
find a_ExplicitVarSizeWithMarker_Values: matrix indexed by [int(1..2)] of int(1..2)
find b_Occurrence: matrix indexed by [int(1..2)] of bool
branching on [a_ExplicitVarSizeWithMarker_Marker, a_ExplicitVarSizeWithMarker_Values, b_Occurrence]
such that
    and([q6 <= a_ExplicitVarSizeWithMarker_Marker -> b_Occurrence[a_ExplicitVarSizeWithMarker_Values[q6]]
             | q6 : int(1..2)])
    /\
    and([b_Occurrence[q7] ->
         or([q9 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q9] = q7 | q9 : int(1..2)])
             | q7 : int(1..2)])
    \/
    (or([q12 <= a_ExplicitVarSizeWithMarker_Marker /\
         (toInt(or([q25 <= a_ExplicitVarSizeWithMarker_Marker /\
                    a_ExplicitVarSizeWithMarker_Values[q25] = a_ExplicitVarSizeWithMarker_Values[q12]
                        | q25 : int(1..2)]))
          < toInt(b_Occurrence[a_ExplicitVarSizeWithMarker_Values[q12]])
          /\
          (and([q26 <= a_ExplicitVarSizeWithMarker_Marker /\
                a_ExplicitVarSizeWithMarker_Values[q26] < a_ExplicitVarSizeWithMarker_Values[q12]
                ->
                toInt(or([q32 <= a_ExplicitVarSizeWithMarker_Marker /\
                          a_ExplicitVarSizeWithMarker_Values[q32] = a_ExplicitVarSizeWithMarker_Values[q26]
                              | q32 : int(1..2)]))
                = toInt(b_Occurrence[a_ExplicitVarSizeWithMarker_Values[q26]])
                    | q26 : int(1..2)])
           /\
           and([and([b_Occurrence[q11],
                     !or([q30 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q30] = q11
                              | q30 : int(1..2)]),
                     q11 < a_ExplicitVarSizeWithMarker_Values[q12];
                         int(1..3)])
                ->
                toInt(or([q28 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q28] = q11
                              | q28 : int(1..2)]))
                = toInt(b_Occurrence[q11])
                    | q11 : int(1..2)])))
             | q12 : int(1..2)])
     \/
     or([b_Occurrence[q10] /\
         !or([q23 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q23] = q10
                  | q23 : int(1..2)])
         /\
         (toInt(or([q14 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q14] = q10
                        | q14 : int(1..2)]))
          < toInt(b_Occurrence[q10])
          /\
          (and([q15 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q15] < q10 ->
                toInt(or([q21 <= a_ExplicitVarSizeWithMarker_Marker /\
                          a_ExplicitVarSizeWithMarker_Values[q21] = a_ExplicitVarSizeWithMarker_Values[q15]
                              | q21 : int(1..2)]))
                = toInt(b_Occurrence[a_ExplicitVarSizeWithMarker_Values[q15]])
                    | q15 : int(1..2)])
           /\
           and([b_Occurrence[q11] /\
                !or([q19 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q19] = q11
                         | q19 : int(1..2)])
                ->
                toInt(or([q17 <= a_ExplicitVarSizeWithMarker_Marker /\ a_ExplicitVarSizeWithMarker_Values[q17] = q11
                              | q17 : int(1..2)]))
                = toInt(b_Occurrence[q11])
                    | q11 : int(1..2), q11 < q10])))
             | q10 : int(1..2)])),
    2 <= a_ExplicitVarSizeWithMarker_Marker ->
    a_ExplicitVarSizeWithMarker_Values[1] < a_ExplicitVarSizeWithMarker_Values[2],
    and([q2 > a_ExplicitVarSizeWithMarker_Marker -> a_ExplicitVarSizeWithMarker_Values[q2] = 1 | q2 : int(1..2)]),
    a_ExplicitVarSizeWithMarker_Marker <= 2,
    sum([toInt(b_Occurrence[q4]) | q4 : int(1..2)]) <= 2

