language ESSENCE' 1.0

find a_Occurrence: matrix indexed by [int(1..2)] of bool
find b_ExplicitVarSizeWithMarker_Marker: int(0..2)
find b_ExplicitVarSizeWithMarker_Values: matrix indexed by [int(1..2)] of int(1..2)
branching on [a_Occurrence, b_ExplicitVarSizeWithMarker_Marker, b_ExplicitVarSizeWithMarker_Values]
such that
    and([a_Occurrence[q5] ->
         or([q7 <= b_ExplicitVarSizeWithMarker_Marker /\ b_ExplicitVarSizeWithMarker_Values[q7] = q5 | q7 : int(1..2)])
             | q5 : int(1..2)])
    /\
    and([q9 <= b_ExplicitVarSizeWithMarker_Marker -> a_Occurrence[b_ExplicitVarSizeWithMarker_Values[q9]]
             | q9 : int(1..2)])
    \/
    (or([a_Occurrence[q10] /\
         (toInt(a_Occurrence[q10]) <
          toInt(or([q23 <= b_ExplicitVarSizeWithMarker_Marker /\ b_ExplicitVarSizeWithMarker_Values[q23] = q10
                        | q23 : int(1..2)]))
          /\
          (and([a_Occurrence[q11] ->
                toInt(a_Occurrence[q11]) =
                toInt(or([q29 <= b_ExplicitVarSizeWithMarker_Marker /\ b_ExplicitVarSizeWithMarker_Values[q29] = q11
                              | q29 : int(1..2)]))
                    | q11 : int(1..2), q11 < q10])
           /\
           and([and([q24 <= b_ExplicitVarSizeWithMarker_Marker,
                     !or([a_Occurrence[q27] /\ q27 = b_ExplicitVarSizeWithMarker_Values[q24] | q27 : int(1..2)]),
                     b_ExplicitVarSizeWithMarker_Values[q24] < q10;
                         int(1..3)])
                ->
                toInt(a_Occurrence[b_ExplicitVarSizeWithMarker_Values[q24]]) =
                toInt(or([q26 <= b_ExplicitVarSizeWithMarker_Marker /\
                          b_ExplicitVarSizeWithMarker_Values[q26] = b_ExplicitVarSizeWithMarker_Values[q24]
                              | q26 : int(1..2)]))
                    | q24 : int(1..2)])))
             | q10 : int(1..2)])
     \/
     or([q12 <= b_ExplicitVarSizeWithMarker_Marker /\
         !or([a_Occurrence[q21] /\ q21 = b_ExplicitVarSizeWithMarker_Values[q12] | q21 : int(1..2)])
         /\
         (toInt(a_Occurrence[b_ExplicitVarSizeWithMarker_Values[q12]]) <
          toInt(or([q14 <= b_ExplicitVarSizeWithMarker_Marker /\
                    b_ExplicitVarSizeWithMarker_Values[q14] = b_ExplicitVarSizeWithMarker_Values[q12]
                        | q14 : int(1..2)]))
          /\
          (and([a_Occurrence[q11] /\ q11 < b_ExplicitVarSizeWithMarker_Values[q12] ->
                toInt(a_Occurrence[q11]) =
                toInt(or([q20 <= b_ExplicitVarSizeWithMarker_Marker /\ b_ExplicitVarSizeWithMarker_Values[q20] = q11
                              | q20 : int(1..2)]))
                    | q11 : int(1..2)])
           /\
           and([and([q15 <= b_ExplicitVarSizeWithMarker_Marker,
                     !or([a_Occurrence[q18] /\ q18 = b_ExplicitVarSizeWithMarker_Values[q15] | q18 : int(1..2)]),
                     b_ExplicitVarSizeWithMarker_Values[q15] < b_ExplicitVarSizeWithMarker_Values[q12];
                         int(1..3)])
                ->
                toInt(a_Occurrence[b_ExplicitVarSizeWithMarker_Values[q15]]) =
                toInt(or([q17 <= b_ExplicitVarSizeWithMarker_Marker /\
                          b_ExplicitVarSizeWithMarker_Values[q17] = b_ExplicitVarSizeWithMarker_Values[q15]
                              | q17 : int(1..2)]))
                    | q15 : int(1..2)])))
             | q12 : int(1..2)])),
    sum([toInt(a_Occurrence[q1]) | q1 : int(1..2)]) <= 2,
    2 <= b_ExplicitVarSizeWithMarker_Marker ->
    b_ExplicitVarSizeWithMarker_Values[1] < b_ExplicitVarSizeWithMarker_Values[2],
    and([q3 > b_ExplicitVarSizeWithMarker_Marker -> b_ExplicitVarSizeWithMarker_Values[q3] = 1 | q3 : int(1..2)]),
    b_ExplicitVarSizeWithMarker_Marker <= 2

