language ESSENCE' 1.0

find a_ExplicitWithRepetition_Flag: int(0..2)
find a_ExplicitWithRepetition_Values: matrix indexed by [int(1..2)] of int(1..2)
find b_ExplicitWithRepetition_Flag: int(0..2)
find b_ExplicitWithRepetition_Values: matrix indexed by [int(1..2)] of int(1..2)
branching on
    [a_ExplicitWithRepetition_Flag, a_ExplicitWithRepetition_Values, b_ExplicitWithRepetition_Flag,
     b_ExplicitWithRepetition_Values]
such that
    flatten([[toInt(q11 <= a_ExplicitWithRepetition_Flag),
              -a_ExplicitWithRepetition_Values[q11] * toInt(q11 <= a_ExplicitWithRepetition_Flag);
                  int(1..2)]
                 | q11 : int(1..2)])
    <=lex
    flatten([[toInt(q12 <= b_ExplicitWithRepetition_Flag),
              -b_ExplicitWithRepetition_Values[q12] * toInt(q12 <= b_ExplicitWithRepetition_Flag);
                  int(1..2)]
                 | q12 : int(1..2)]),
    2 <= a_ExplicitWithRepetition_Flag -> a_ExplicitWithRepetition_Values[1] <= a_ExplicitWithRepetition_Values[2],
    and([q2 > a_ExplicitWithRepetition_Flag -> a_ExplicitWithRepetition_Values[q2] = 1 | q2 : int(1..2)]),
    a_ExplicitWithRepetition_Flag <= 2,
    2 <= b_ExplicitWithRepetition_Flag -> b_ExplicitWithRepetition_Values[1] <= b_ExplicitWithRepetition_Values[2],
    and([q7 > b_ExplicitWithRepetition_Flag -> b_ExplicitWithRepetition_Values[q7] = 1 | q7 : int(1..2)]),
    b_ExplicitWithRepetition_Flag <= 2

