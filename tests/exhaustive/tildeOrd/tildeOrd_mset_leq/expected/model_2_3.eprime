language ESSENCE' 1.0

find a_ExplicitWithRepetition_Flag: int(0..2)
find a_ExplicitWithRepetition_Values: matrix indexed by [int(1..2)] of int(1..2)
find b_MOccurrence: matrix indexed by [int(1..2)] of int(0..2)
branching on [a_ExplicitWithRepetition_Flag, a_ExplicitWithRepetition_Values, b_MOccurrence]
such that
    and([q8 <= a_ExplicitWithRepetition_Flag ->
         sum([toInt(q10 <= a_ExplicitWithRepetition_Flag) *
              catchUndef(toInt(a_ExplicitWithRepetition_Values[q10] = a_ExplicitWithRepetition_Values[q8]), 0)
                  | q10 : int(1..2)])
         = b_MOccurrence[a_ExplicitWithRepetition_Values[q8]]
             | q8 : int(1..2)])
    /\
    and([b_MOccurrence[q11] > 0 ->
         sum([toInt(q13 <= a_ExplicitWithRepetition_Flag) *
              catchUndef(toInt(a_ExplicitWithRepetition_Values[q13] = q11), 0)
                  | q13 : int(1..2)])
         = b_MOccurrence[q11]
             | q11 : int(1..2)])
    \/
    (or([q27 <= a_ExplicitWithRepetition_Flag /\
         (sum([toInt(q23 <= a_ExplicitWithRepetition_Flag) *
               catchUndef(toInt(a_ExplicitWithRepetition_Values[q23] = a_ExplicitWithRepetition_Values[q27]), 0)
                   | q23 : int(1..2)])
          < b_MOccurrence[a_ExplicitWithRepetition_Values[q27]]
          /\
          (and([q21 <= a_ExplicitWithRepetition_Flag /\
                a_ExplicitWithRepetition_Values[q21] < a_ExplicitWithRepetition_Values[q27]
                ->
                sum([toInt(q17 <= a_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(a_ExplicitWithRepetition_Values[q17] = a_ExplicitWithRepetition_Values[q21]), 0)
                         | q17 : int(1..2)])
                = b_MOccurrence[a_ExplicitWithRepetition_Values[q21]]
                    | q21 : int(1..2)])
           /\
           and([q15 < a_ExplicitWithRepetition_Values[q27] ->
                (b_MOccurrence[q15] > 0 /\
                 (sum([toInt(q20 <= a_ExplicitWithRepetition_Flag) *
                       catchUndef(toInt(a_ExplicitWithRepetition_Values[q20] = q15), 0)
                           | q20 : int(1..2)])
                  < q18
                  /\ q18 <= b_MOccurrence[q15])
                 ->
                 sum([toInt(q17 <= a_ExplicitWithRepetition_Flag) *
                      catchUndef(toInt(a_ExplicitWithRepetition_Values[q17] = q15), 0)
                          | q17 : int(1..2)])
                 = b_MOccurrence[q15])
                    | q15 : int(1..2), q18 : int(1..2)])))
             | q27 : int(1..2)])
     \/
     or([b_MOccurrence[q14] > 0 /\
         (sum([toInt(q26 <= a_ExplicitWithRepetition_Flag) *
               catchUndef(toInt(a_ExplicitWithRepetition_Values[q26] = q14), 0)
                   | q26 : int(1..2)])
          < q24
          /\ q24 <= b_MOccurrence[q14])
         /\
         (sum([toInt(q23 <= a_ExplicitWithRepetition_Flag) *
               catchUndef(toInt(a_ExplicitWithRepetition_Values[q23] = q14), 0)
                   | q23 : int(1..2)])
          < b_MOccurrence[q14]
          /\
          (and([q21 <= a_ExplicitWithRepetition_Flag /\ a_ExplicitWithRepetition_Values[q21] < q14 ->
                sum([toInt(q17 <= a_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(a_ExplicitWithRepetition_Values[q17] = a_ExplicitWithRepetition_Values[q21]), 0)
                         | q17 : int(1..2)])
                = b_MOccurrence[a_ExplicitWithRepetition_Values[q21]]
                    | q21 : int(1..2)])
           /\
           and([b_MOccurrence[q15] > 0 /\
                (sum([toInt(q20 <= a_ExplicitWithRepetition_Flag) *
                      catchUndef(toInt(a_ExplicitWithRepetition_Values[q20] = q15), 0)
                          | q20 : int(1..2)])
                 < q18
                 /\ q18 <= b_MOccurrence[q15])
                ->
                sum([toInt(q17 <= a_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(a_ExplicitWithRepetition_Values[q17] = q15), 0)
                         | q17 : int(1..2)])
                = b_MOccurrence[q15]
                    | q15 : int(1..2), q18 : int(1..2), q15 < q14])))
             | q14 : int(1..2), q24 : int(1..2)])),
    2 <= a_ExplicitWithRepetition_Flag -> a_ExplicitWithRepetition_Values[1] <= a_ExplicitWithRepetition_Values[2],
    and([q2 > a_ExplicitWithRepetition_Flag -> a_ExplicitWithRepetition_Values[q2] = 1 | q2 : int(1..2)]),
    a_ExplicitWithRepetition_Flag <= 2,
    sum([b_MOccurrence[q6] | q6 : int(1..2)]) <= 2

