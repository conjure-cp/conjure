language ESSENCE' 1.0

find a_MOccurrence: matrix indexed by [int(1..2)] of int(0..2)
find b_ExplicitWithRepetition_Flag: int(0..2)
find b_ExplicitWithRepetition_Values: matrix indexed by [int(1..2)] of int(1..2)
branching on [a_MOccurrence, b_ExplicitWithRepetition_Flag, b_ExplicitWithRepetition_Values]
such that
    and([a_MOccurrence[q8] > 0 ->
         a_MOccurrence[q8] =
         sum([toInt(q10 <= b_ExplicitWithRepetition_Flag) *
              catchUndef(toInt(b_ExplicitWithRepetition_Values[q10] = q8), 0)
                  | q10 : int(1..2)])
             | q8 : int(1..2)])
    /\
    and([q11 <= b_ExplicitWithRepetition_Flag ->
         a_MOccurrence[b_ExplicitWithRepetition_Values[q11]] =
         sum([toInt(q13 <= b_ExplicitWithRepetition_Flag) *
              catchUndef(toInt(b_ExplicitWithRepetition_Values[q13] = b_ExplicitWithRepetition_Values[q11]), 0)
                  | q13 : int(1..2)])
             | q11 : int(1..2)])
    \/
    (or([a_MOccurrence[q31] > 0 /\
         (a_MOccurrence[q31] <
          sum([toInt(q17 <= b_ExplicitWithRepetition_Flag) *
               catchUndef(toInt(b_ExplicitWithRepetition_Values[q17] = q31), 0)
                   | q17 : int(1..2)])
          /\
          (and([a_MOccurrence[q25] > 0 ->
                a_MOccurrence[q25] =
                sum([toInt(q19 <= b_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(b_ExplicitWithRepetition_Values[q19] = q25), 0)
                         | q19 : int(1..2)])
                    | q25 : int(1..2), q25 < q31])
           /\
           and([sum([toInt(q24 <= b_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(b_ExplicitWithRepetition_Values[q24] = q15), 0)
                         | q24 : int(1..2)])
                > 0
                /\
                (a_MOccurrence[q15] < q20 /\
                 q20 <=
                 sum([toInt(q22 <= b_ExplicitWithRepetition_Flag) *
                      catchUndef(toInt(b_ExplicitWithRepetition_Values[q22] = q15), 0)
                          | q22 : int(1..2)]))
                ->
                a_MOccurrence[q15] =
                sum([toInt(q19 <= b_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(b_ExplicitWithRepetition_Values[q19] = q15), 0)
                         | q19 : int(1..2)])
                    | q15 : int(1..2), q20 : int(1..2), q15 < q31])))
             | q31 : int(1..2)])
     \/
     or([sum([toInt(q30 <= b_ExplicitWithRepetition_Flag) *
              catchUndef(toInt(b_ExplicitWithRepetition_Values[q30] = q14), 0)
                  | q30 : int(1..2)])
         > 0
         /\
         (a_MOccurrence[q14] < q26 /\
          q26 <=
          sum([toInt(q28 <= b_ExplicitWithRepetition_Flag) *
               catchUndef(toInt(b_ExplicitWithRepetition_Values[q28] = q14), 0)
                   | q28 : int(1..2)]))
         /\
         (a_MOccurrence[q14] <
          sum([toInt(q17 <= b_ExplicitWithRepetition_Flag) *
               catchUndef(toInt(b_ExplicitWithRepetition_Values[q17] = q14), 0)
                   | q17 : int(1..2)])
          /\
          (and([a_MOccurrence[q25] > 0 ->
                a_MOccurrence[q25] =
                sum([toInt(q19 <= b_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(b_ExplicitWithRepetition_Values[q19] = q25), 0)
                         | q19 : int(1..2)])
                    | q25 : int(1..2), q25 < q14])
           /\
           and([sum([toInt(q24 <= b_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(b_ExplicitWithRepetition_Values[q24] = q15), 0)
                         | q24 : int(1..2)])
                > 0
                /\
                (a_MOccurrence[q15] < q20 /\
                 q20 <=
                 sum([toInt(q22 <= b_ExplicitWithRepetition_Flag) *
                      catchUndef(toInt(b_ExplicitWithRepetition_Values[q22] = q15), 0)
                          | q22 : int(1..2)]))
                ->
                a_MOccurrence[q15] =
                sum([toInt(q19 <= b_ExplicitWithRepetition_Flag) *
                     catchUndef(toInt(b_ExplicitWithRepetition_Values[q19] = q15), 0)
                         | q19 : int(1..2)])
                    | q15 : int(1..2), q20 : int(1..2), q15 < q14])))
             | q14 : int(1..2), q26 : int(1..2)])),
    sum([a_MOccurrence[q1] | q1 : int(1..2)]) <= 2,
    2 <= b_ExplicitWithRepetition_Flag -> b_ExplicitWithRepetition_Values[1] <= b_ExplicitWithRepetition_Values[2],
    and([q3 > b_ExplicitWithRepetition_Flag -> b_ExplicitWithRepetition_Values[q3] = 1 | q3 : int(1..2)]),
    b_ExplicitWithRepetition_Flag <= 2

