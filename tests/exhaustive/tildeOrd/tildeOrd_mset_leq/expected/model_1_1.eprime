language ESSENCE' 1.0

find a_ExplicitWithFlags_Flags: matrix indexed by [int(1..2)] of int(0..2)
find a_ExplicitWithFlags_Values: matrix indexed by [int(1..2)] of int(1..2)
find b_ExplicitWithFlags_Flags: matrix indexed by [int(1..2)] of int(0..2)
find b_ExplicitWithFlags_Values: matrix indexed by [int(1..2)] of int(1..2)
branching on
    [a_ExplicitWithFlags_Flags, a_ExplicitWithFlags_Values, b_ExplicitWithFlags_Flags, b_ExplicitWithFlags_Values]
such that
    flatten([[toInt(a_ExplicitWithFlags_Flags[q13] > 0),
              -a_ExplicitWithFlags_Values[q13] * toInt(a_ExplicitWithFlags_Flags[q13] > 0),
              a_ExplicitWithFlags_Flags[q13];
                  int(1..3)]
                 | q13 : int(1..2)])
    <=lex
    flatten([[toInt(b_ExplicitWithFlags_Flags[q14] > 0),
              -b_ExplicitWithFlags_Values[q14] * toInt(b_ExplicitWithFlags_Flags[q14] > 0),
              b_ExplicitWithFlags_Flags[q14];
                  int(1..3)]
                 | q14 : int(1..2)]),
    a_ExplicitWithFlags_Flags[2] > 0 -> a_ExplicitWithFlags_Values[1] < a_ExplicitWithFlags_Values[2],
    and([a_ExplicitWithFlags_Flags[q2] = 0 -> a_ExplicitWithFlags_Values[q2] = 1 | q2 : int(1..2)]),
    a_ExplicitWithFlags_Flags[2] > 0 -> a_ExplicitWithFlags_Flags[1] > 0,
    sum([a_ExplicitWithFlags_Flags[q5] | q5 : int(1..2)]) <= 2,
    b_ExplicitWithFlags_Flags[2] > 0 -> b_ExplicitWithFlags_Values[1] < b_ExplicitWithFlags_Values[2],
    and([b_ExplicitWithFlags_Flags[q8] = 0 -> b_ExplicitWithFlags_Values[q8] = 1 | q8 : int(1..2)]),
    b_ExplicitWithFlags_Flags[2] > 0 -> b_ExplicitWithFlags_Flags[1] > 0,
    sum([b_ExplicitWithFlags_Flags[q11] | q11 : int(1..2)]) <= 2

