language ESSENCE' 1.0

find a_Occurrence: matrix indexed by [int(1..4)] of bool
find b_Explicit: matrix indexed by [int(1..3)] of int(1..4)
branching on [a_Occurrence, b_Explicit]
such that
    or([toInt(a_Occurrence[b_Explicit[q7]]) < toInt(or([b_Explicit[q11] = b_Explicit[q7] | q11 : int(1..3)])) /\
        and([a_Occurrence[q5] /\ q5 < b_Explicit[q7] ->
             toInt(a_Occurrence[q5]) = toInt(or([b_Explicit[q9] = q5 | q9 : int(1..3)]))
                 | q5 : int(1..4)])
        /\
        and([b_Explicit[q12] < b_Explicit[q7] ->
             toInt(a_Occurrence[b_Explicit[q12]]) = toInt(or([b_Explicit[q14] = b_Explicit[q12] | q14 : int(1..3)]))
                 | q12 : int(1..3)])
            | q7 : int(1..3)]),
    3 = sum([toInt(a_Occurrence[q1]) | q1 : int(1..4)]),
    and([b_Explicit[q2] < b_Explicit[q2 + 1] | q2 : int(1..2)])

