language ESSENCE' 1.0

find a_Explicit: matrix indexed by [int(1..3)] of int(1..4)
find b_Explicit: matrix indexed by [int(1..3)] of int(1..4)
branching on [a_Explicit, b_Explicit]
such that
    or([toInt(or([a_Explicit[q15] = b_Explicit[q8] | q15 : int(1..3)])) <
        toInt(or([b_Explicit[q17] = b_Explicit[q8] | q17 : int(1..3)]))
        /\
        and([a_Explicit[q9] < b_Explicit[q8] ->
             toInt(or([a_Explicit[q11] = a_Explicit[q9] | q11 : int(1..3)])) =
             toInt(or([b_Explicit[q13] = a_Explicit[q9] | q13 : int(1..3)]))
                 | q9 : int(1..3)])
        /\
        and([b_Explicit[q18] < b_Explicit[q8] ->
             toInt(or([a_Explicit[q20] = b_Explicit[q18] | q20 : int(1..3)])) =
             toInt(or([b_Explicit[q22] = b_Explicit[q18] | q22 : int(1..3)]))
                 | q18 : int(1..3)])
            | q8 : int(1..3)]),
    and([a_Explicit[q1] < a_Explicit[q1 + 1] | q1 : int(1..2)]),
    and([b_Explicit[q3] < b_Explicit[q3 + 1] | q3 : int(1..2)])

