language ESSENCE' 1.0

find a_Explicit: matrix indexed by [int(1..3)] of int(1..4)
find b_Occurrence: matrix indexed by [int(1..4)] of bool
branching on [a_Explicit, b_Occurrence]
such that
    or([b_Occurrence[q4] /\
        (toInt(or([a_Explicit[q11] = q4 | q11 : int(1..3)])) < toInt(b_Occurrence[q4]) /\
         and([a_Explicit[q7] < q4 ->
              toInt(or([a_Explicit[q9] = a_Explicit[q7] | q9 : int(1..3)])) = toInt(b_Occurrence[a_Explicit[q7]])
                  | q7 : int(1..3)])
         /\
         and([b_Occurrence[q6] -> toInt(or([a_Explicit[q13] = q6 | q13 : int(1..3)])) = toInt(b_Occurrence[q6])
                  | q6 : int(1..4), q6 < q4]))
            | q4 : int(1..4)]),
    and([a_Explicit[q1] < a_Explicit[q1 + 1] | q1 : int(1..2)]),
    3 = sum([toInt(b_Occurrence[q3]) | q3 : int(1..4)])

