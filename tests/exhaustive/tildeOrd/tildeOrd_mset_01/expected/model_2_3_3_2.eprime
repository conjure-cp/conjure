                        | q30 : int(1..3), q30 <= 3])
               = b_MOccurrence[a_ExplicitWithRepetition_Values[q34]]
                   | q34 : int(1..3), q34 <= 3])
          /\
          and([b_MOccurrence[q28] > 0 /\
