         q37 <= b_MOccurrence[q27])
        /\
        (sum([toInt(a_ExplicitWithRepetition_Values[q36] = q27) | q36 : int(1..3), q36 <= 3]) < b_MOccurrence[q27] /\
         (and([a_ExplicitWithRepetition_Values[q34] < q27 ->
