language ESSENCE' 1.0

find a_MOccurrence: matrix indexed by [int(1..2)] of int(0..3)
find b_ExplicitWithRepetition_Flag: int(3)
find b_ExplicitWithRepetition_Values: matrix indexed by [int(1..3)] of int(1..2)
branching on [a_MOccurrence, b_ExplicitWithRepetition_Flag, b_ExplicitWithRepetition_Values]
such that
    or([a_MOccurrence[q24] > 0 /\
        (a_MOccurrence[q24] < sum([toInt(b_ExplicitWithRepetition_Values[q10] = q24) | q10 : int(1..3), q10 <= 3]) /\
         (and([a_MOccurrence[q18] > 0 ->
               a_MOccurrence[q18] = sum([toInt(b_ExplicitWithRepetition_Values[q12] = q18) | q12 : int(1..3), q12 <= 3])
                   | q18 : int(1..2), q18 < q24])
          /\
          and([sum([toInt(b_ExplicitWithRepetition_Values[q17] = q8) | q17 : int(1..3), q17 <= 3]) > 0 /\
               (a_MOccurrence[q8] < q13 /\
                q13 <= sum([toInt(b_ExplicitWithRepetition_Values[q15] = q8) | q15 : int(1..3), q15 <= 3]))
               ->
               a_MOccurrence[q8] = sum([toInt(b_ExplicitWithRepetition_Values[q12] = q8) | q12 : int(1..3), q12 <= 3])
                   | q8 : int(1..2), q13 : int(1..3), q8 < q24])))
            | q24 : int(1..2)])
    \/
    or([sum([toInt(b_ExplicitWithRepetition_Values[q23] = q7) | q23 : int(1..3), q23 <= 3]) > 0 /\
        (a_MOccurrence[q7] < q19 /\
         q19 <= sum([toInt(b_ExplicitWithRepetition_Values[q21] = q7) | q21 : int(1..3), q21 <= 3]))
        /\
        (a_MOccurrence[q7] < sum([toInt(b_ExplicitWithRepetition_Values[q10] = q7) | q10 : int(1..3), q10 <= 3]) /\
         (and([a_MOccurrence[q18] > 0 ->
               a_MOccurrence[q18] = sum([toInt(b_ExplicitWithRepetition_Values[q12] = q18) | q12 : int(1..3), q12 <= 3])
                   | q18 : int(1..2), q18 < q7])
          /\
          and([sum([toInt(b_ExplicitWithRepetition_Values[q17] = q8) | q17 : int(1..3), q17 <= 3]) > 0 /\
               (a_MOccurrence[q8] < q13 /\
                q13 <= sum([toInt(b_ExplicitWithRepetition_Values[q15] = q8) | q15 : int(1..3), q15 <= 3]))
               ->
               a_MOccurrence[q8] = sum([toInt(b_ExplicitWithRepetition_Values[q12] = q8) | q12 : int(1..3), q12 <= 3])
                   | q8 : int(1..2), q13 : int(1..3), q8 < q7])))
            | q7 : int(1..2), q19 : int(1..3)]),
    3 = sum([a_MOccurrence[q1] | q1 : int(1..2)]),
    and([b_ExplicitWithRepetition_Values[q2] <= b_ExplicitWithRepetition_Values[q2 + 1] | q2 : int(1..2), q2 + 1 <= 3])

