language ESSENCE' 1.0

find a_MOccurrence: matrix indexed by [int(1..2)] of int(0..3)
find b_ExplicitWithRepetition_Flag: int(3)
find b_ExplicitWithRepetition_Values: matrix indexed by [int(1..3)] of int(1..2)
branching on [a_MOccurrence, b_ExplicitWithRepetition_Flag, b_ExplicitWithRepetition_Values]
such that
    or([a_MOccurrence[b_ExplicitWithRepetition_Values[q10]] <
        sum([toInt(b_ExplicitWithRepetition_Values[q12] = b_ExplicitWithRepetition_Values[q10])
                 | q12 : int(1..3), q12 <= 3])
        /\
        and([a_MOccurrence[q13] > 0 /\ q13 < b_ExplicitWithRepetition_Values[q10] ->
             a_MOccurrence[q13] = sum([toInt(b_ExplicitWithRepetition_Values[q15] = q13) | q15 : int(1..3), q15 <= 3])
                 | q13 : int(1..2)])
        /\
        and([b_ExplicitWithRepetition_Values[q16] < b_ExplicitWithRepetition_Values[q10] ->
             a_MOccurrence[b_ExplicitWithRepetition_Values[q16]] =
             sum([toInt(b_ExplicitWithRepetition_Values[q18] = b_ExplicitWithRepetition_Values[q16])
                      | q18 : int(1..3), q18 <= 3])
                 | q16 : int(1..3), q16 <= 3])
            | q10 : int(1..3), q10 <= 3]),
    3 = sum([a_MOccurrence[q1] | q1 : int(1..2)]),
    and([b_ExplicitWithRepetition_Values[q2] <= b_ExplicitWithRepetition_Values[q2 + 1] | q2 : int(1..2), q2 + 1 <= 3])

