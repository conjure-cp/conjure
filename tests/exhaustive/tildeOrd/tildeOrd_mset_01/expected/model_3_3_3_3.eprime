language ESSENCE' 1.0

find a_MOccurrence: matrix indexed by [int(1..2)] of int(0..3)
find b_MOccurrence: matrix indexed by [int(1..2)] of int(0..3)
branching on [a_MOccurrence, b_MOccurrence]
such that
    or([a_MOccurrence[q8] > 0 /\
        (a_MOccurrence[q8] < b_MOccurrence[q8] /\
         (and([a_MOccurrence[q6] > 0 -> a_MOccurrence[q6] = b_MOccurrence[q6] | q6 : int(1..2), q6 < q8]) /\
          and([b_MOccurrence[q4] > 0 /\ (a_MOccurrence[q4] < q5 /\ q5 <= b_MOccurrence[q4]) ->
               a_MOccurrence[q4] = b_MOccurrence[q4]
                   | q4 : int(1..2), q5 : int(1..3), q4 < q8])))
            | q8 : int(1..2)])
    \/
    or([b_MOccurrence[q3] > 0 /\ (a_MOccurrence[q3] < q7 /\ q7 <= b_MOccurrence[q3]) /\
        (a_MOccurrence[q3] < b_MOccurrence[q3] /\
         (and([a_MOccurrence[q6] > 0 -> a_MOccurrence[q6] = b_MOccurrence[q6] | q6 : int(1..2), q6 < q3]) /\
          and([b_MOccurrence[q4] > 0 /\ (a_MOccurrence[q4] < q5 /\ q5 <= b_MOccurrence[q4]) ->
               a_MOccurrence[q4] = b_MOccurrence[q4]
                   | q4 : int(1..2), q5 : int(1..3), q4 < q3])))
            | q3 : int(1..2), q7 : int(1..3)]),
    3 = sum([a_MOccurrence[q1] | q1 : int(1..2)]),
    3 = sum([b_MOccurrence[q2] | q2 : int(1..2)])

