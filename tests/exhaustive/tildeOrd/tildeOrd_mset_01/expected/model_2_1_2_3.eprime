               > 0
               /\
               (sum([toInt(a_ExplicitWithRepetition_Values[q27] = q19) | q27 : int(1..3), q27 <= 3]) < q24 /\
                q24 <=
                sum([toInt(b_ExplicitWithFlags_Values[q25] = q19) * catchUndef(b_ExplicitWithFlags_Flags[q25], 0)
                         | q25 : int(1..3)]))
               ->
               sum([toInt(a_ExplicitWithRepetition_Values[q23] = q19) | q23 : int(1..3), q23 <= 3]) =
               sum([toInt(b_ExplicitWithFlags_Values[q21] = q19) * catchUndef(b_ExplicitWithFlags_Flags[q21], 0)
                        | q21 : int(1..3)]))
                  | q19 : int(1..2), q24 : int(1..3)]))
            | q37 : int(1..3), q37 <= 3])
    \/
    or([sum([toInt(b_ExplicitWithFlags_Values[q36] = q18) * catchUndef(b_ExplicitWithFlags_Flags[q36], 0)
                 | q36 : int(1..3)])
        > 0
        /\
        (sum([toInt(a_ExplicitWithRepetition_Values[q35] = q18) | q35 : int(1..3), q35 <= 3]) < q32 /\
         q32 <=
         sum([toInt(b_ExplicitWithFlags_Values[q33] = q18) * catchUndef(b_ExplicitWithFlags_Flags[q33], 0)
                  | q33 : int(1..3)]))
        /\
        (sum([toInt(a_ExplicitWithRepetition_Values[q31] = q18) | q31 : int(1..3), q31 <= 3]) <
         sum([toInt(b_ExplicitWithFlags_Values[q20] = q18) * catchUndef(b_ExplicitWithFlags_Flags[q20], 0)
                  | q20 : int(1..3)])
         /\
         (and([a_ExplicitWithRepetition_Values[q29] < q18 ->
               sum([toInt(a_ExplicitWithRepetition_Values[q23] = a_ExplicitWithRepetition_Values[q29])
                        | q23 : int(1..3), q23 <= 3])
               =
               sum([toInt(b_ExplicitWithFlags_Values[q21] = a_ExplicitWithRepetition_Values[q29]) *
                    catchUndef(b_ExplicitWithFlags_Flags[q21], 0)
                        | q21 : int(1..3)])
                   | q29 : int(1..3), q29 <= 3])
          /\
          and([sum([toInt(b_ExplicitWithFlags_Values[q28] = q19) * catchUndef(b_ExplicitWithFlags_Flags[q28], 0)
                        | q28 : int(1..3)])
               > 0
               /\
               (sum([toInt(a_ExplicitWithRepetition_Values[q27] = q19) | q27 : int(1..3), q27 <= 3]) < q24 /\
                q24 <=
                sum([toInt(b_ExplicitWithFlags_Values[q25] = q19) * catchUndef(b_ExplicitWithFlags_Flags[q25], 0)
