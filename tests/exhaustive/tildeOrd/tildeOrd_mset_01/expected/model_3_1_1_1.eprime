    and([a_ExplicitWithFlags_Flags[q9] = 0 -> a_ExplicitWithFlags_Values[q9] = 1 | q9 : int(1..3)]),
    and([a_ExplicitWithFlags_Flags[q10 + 1] > 0 -> a_ExplicitWithFlags_Flags[q10] > 0 | q10 : int(1..2)]),
