                        | q22 : int(1..3)])
                   | q20 : int(1..2), q23 : int(1..3), q20 < q30])))
            | q30 : int(1..2)])
    \/
    or([sum([toInt(b_ExplicitWithFlags_Values[q29] = q19) * catchUndef(b_ExplicitWithFlags_Flags[q29], 0)
                 | q29 : int(1..3)])
        > 0
        /\
        (a_MOccurrence[q19] < q27 /\
         q27 <=
         sum([toInt(b_ExplicitWithFlags_Values[q28] = q19) * catchUndef(b_ExplicitWithFlags_Flags[q28], 0)
                  | q28 : int(1..3)]))
        /\
        (a_MOccurrence[q19] <
         sum([toInt(b_ExplicitWithFlags_Values[q21] = q19) * catchUndef(b_ExplicitWithFlags_Flags[q21], 0)
                  | q21 : int(1..3)])
         /\
         (and([a_MOccurrence[q26] > 0 ->
               a_MOccurrence[q26] =
               sum([toInt(b_ExplicitWithFlags_Values[q22] = q26) * catchUndef(b_ExplicitWithFlags_Flags[q22], 0)
                        | q22 : int(1..3)])
                   | q26 : int(1..2), q26 < q19])
          /\
          and([sum([toInt(b_ExplicitWithFlags_Values[q25] = q20) * catchUndef(b_ExplicitWithFlags_Flags[q25], 0)
                        | q25 : int(1..3)])
               > 0
               /\
               (a_MOccurrence[q20] < q23 /\
                q23 <=
                sum([toInt(b_ExplicitWithFlags_Values[q24] = q20) * catchUndef(b_ExplicitWithFlags_Flags[q24], 0)
                         | q24 : int(1..3)]))
               ->
               a_MOccurrence[q20] =
               sum([toInt(b_ExplicitWithFlags_Values[q22] = q20) * catchUndef(b_ExplicitWithFlags_Flags[q22], 0)
                        | q22 : int(1..3)])
                   | q20 : int(1..2), q23 : int(1..3), q20 < q19])))
            | q19 : int(1..2), q27 : int(1..3)]),
    3 = sum([a_MOccurrence[q1] | q1 : int(1..2)]),
    and([b_ExplicitWithFlags_Flags[q2 + 1] > 0 -> b_ExplicitWithFlags_Values[q2] < b_ExplicitWithFlags_Values[q2 + 1]
