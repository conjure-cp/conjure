     a_ExplicitWithRepetition_Values, b_ExplicitWithFlags_Flags, b_ExplicitWithFlags_Values, b_MOccurrence]
such that
    or([b_MOccurrence[q36] > 0 /\
        (sum([toInt(a_ExplicitWithRepetition_Values[q41] = q36) | q41 : int(1..3), q41 <= 3]) < b_MOccurrence[q36] /\
         and([a_ExplicitWithRepetition_Values[q37] < q36 ->
