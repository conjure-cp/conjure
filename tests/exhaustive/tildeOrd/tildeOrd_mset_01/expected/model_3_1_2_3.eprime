                        | q29 : int(1..3)])
                   | q33 : int(1..2), q33 < q37])
          /\
          and([sum([toInt(b_ExplicitWithFlags_Values[q32] = q27) * catchUndef(b_ExplicitWithFlags_Flags[q32], 0)
                        | q32 : int(1..3)])
               > 0
               /\
               (a_MOccurrence[q27] < q30 /\
                q30 <=
                sum([toInt(b_ExplicitWithFlags_Values[q31] = q27) * catchUndef(b_ExplicitWithFlags_Flags[q31], 0)
                         | q31 : int(1..3)]))
               ->
               a_MOccurrence[q27] =
               sum([toInt(b_ExplicitWithFlags_Values[q29] = q27) * catchUndef(b_ExplicitWithFlags_Flags[q29], 0)
                        | q29 : int(1..3)])
                   | q27 : int(1..2), q30 : int(1..3), q27 < q37])))
            | q37 : int(1..2)])
    \/
    or([sum([toInt(b_ExplicitWithFlags_Values[q36] = q26) * catchUndef(b_ExplicitWithFlags_Flags[q36], 0)
                 | q36 : int(1..3)])
        > 0
        /\
        (a_MOccurrence[q26] < q34 /\
         q34 <=
         sum([toInt(b_ExplicitWithFlags_Values[q35] = q26) * catchUndef(b_ExplicitWithFlags_Flags[q35], 0)
                  | q35 : int(1..3)]))
        /\
        (a_MOccurrence[q26] <
         sum([toInt(b_ExplicitWithFlags_Values[q28] = q26) * catchUndef(b_ExplicitWithFlags_Flags[q28], 0)
                  | q28 : int(1..3)])
         /\
         (and([a_MOccurrence[q33] > 0 ->
               a_MOccurrence[q33] =
               sum([toInt(b_ExplicitWithFlags_Values[q29] = q33) * catchUndef(b_ExplicitWithFlags_Flags[q29], 0)
                        | q29 : int(1..3)])
                   | q33 : int(1..2), q33 < q26])
          /\
          and([sum([toInt(b_ExplicitWithFlags_Values[q32] = q27) * catchUndef(b_ExplicitWithFlags_Flags[q32], 0)
                        | q32 : int(1..3)])
               > 0
               /\
               (a_MOccurrence[q27] < q30 /\
                q30 <=
                sum([toInt(b_ExplicitWithFlags_Values[q31] = q27) * catchUndef(b_ExplicitWithFlags_Flags[q31], 0)
                         | q31 : int(1..3)]))
               ->
               a_MOccurrence[q27] =
               sum([toInt(b_ExplicitWithFlags_Values[q29] = q27) * catchUndef(b_ExplicitWithFlags_Flags[q29], 0)
                        | q29 : int(1..3)])
                   | q27 : int(1..2), q30 : int(1..3), q27 < q26])))
            | q26 : int(1..2), q34 : int(1..3)]),
    3 = sum([a_MOccurrence[q1] | q1 : int(1..2)]),
    and([b_ExplicitWithFlags_Flags[q2 + 1] > 0 -> b_ExplicitWithFlags_Values[q2] < b_ExplicitWithFlags_Values[q2 + 1]
             | q2 : int(1..2)]),
    and([b_ExplicitWithFlags_Flags[q3] = 0 -> b_ExplicitWithFlags_Values[q3] = 1 | q3 : int(1..3)]),
    and([b_ExplicitWithFlags_Flags[q4 + 1] > 0 -> b_ExplicitWithFlags_Flags[q4] > 0 | q4 : int(1..2)]),
    3 = sum([b_ExplicitWithFlags_Flags[q6] | q6 : int(1..3)]),
    and([a_ExplicitWithRepetition_Values[q8] <= a_ExplicitWithRepetition_Values[q8 + 1] | q8 : int(1..2), q8 + 1 <= 3]),
    and([sum([toInt(a_ExplicitWithRepetition_Values[q16] = a_ExplicitWithRepetition_Values[q14])
                  | q16 : int(1..3), q16 <= 3])
         = a_MOccurrence[a_ExplicitWithRepetition_Values[q14]]
             | q14 : int(1..3), q14 <= 3]),
    and([a_MOccurrence[q17] > 0 ->
         sum([toInt(a_ExplicitWithRepetition_Values[q19] = q17) | q19 : int(1..3), q19 <= 3]) = a_MOccurrence[q17]
             | q17 : int(1..2)]),
    3 = sum([b_MOccurrence[q20] | q20 : int(1..2)]),
    and([b_MOccurrence[q22] > 0 ->
         b_MOccurrence[q22] =
