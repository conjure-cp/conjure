language ESSENCE' 1.0

find a_MOccurrence: matrix indexed by [int(1..2)] of int(0..3)
find a_ExplicitWithRepetition_Flag: int(3)
find a_ExplicitWithRepetition_Values: matrix indexed by [int(1..3)] of int(1..2)
find b_ExplicitWithRepetition_Flag: int(3)
find b_ExplicitWithRepetition_Values: matrix indexed by [int(1..3)] of int(1..2)
branching on
    [a_ExplicitWithRepetition_Flag, a_ExplicitWithRepetition_Values, a_MOccurrence, b_ExplicitWithRepetition_Flag,
     b_ExplicitWithRepetition_Values]
such that
    or([a_MOccurrence[q36] > 0 /\
        (a_MOccurrence[q36] < sum([toInt(b_ExplicitWithRepetition_Values[q22] = q36) | q22 : int(1..3), q22 <= 3]) /\
         (and([a_MOccurrence[q30] > 0 ->
               a_MOccurrence[q30] = sum([toInt(b_ExplicitWithRepetition_Values[q24] = q30) | q24 : int(1..3), q24 <= 3])
                   | q30 : int(1..2), q30 < q36])
          /\
          and([sum([toInt(b_ExplicitWithRepetition_Values[q29] = q20) | q29 : int(1..3), q29 <= 3]) > 0 /\
               (a_MOccurrence[q20] < q25 /\
                q25 <= sum([toInt(b_ExplicitWithRepetition_Values[q27] = q20) | q27 : int(1..3), q27 <= 3]))
               ->
               a_MOccurrence[q20] = sum([toInt(b_ExplicitWithRepetition_Values[q24] = q20) | q24 : int(1..3), q24 <= 3])
                   | q20 : int(1..2), q25 : int(1..3), q20 < q36])))
            | q36 : int(1..2)])
    \/
    or([sum([toInt(b_ExplicitWithRepetition_Values[q35] = q19) | q35 : int(1..3), q35 <= 3]) > 0 /\
        (a_MOccurrence[q19] < q31 /\
         q31 <= sum([toInt(b_ExplicitWithRepetition_Values[q33] = q19) | q33 : int(1..3), q33 <= 3]))
        /\
        (a_MOccurrence[q19] < sum([toInt(b_ExplicitWithRepetition_Values[q22] = q19) | q22 : int(1..3), q22 <= 3]) /\
         (and([a_MOccurrence[q30] > 0 ->
               a_MOccurrence[q30] = sum([toInt(b_ExplicitWithRepetition_Values[q24] = q30) | q24 : int(1..3), q24 <= 3])
                   | q30 : int(1..2), q30 < q19])
          /\
          and([sum([toInt(b_ExplicitWithRepetition_Values[q29] = q20) | q29 : int(1..3), q29 <= 3]) > 0 /\
               (a_MOccurrence[q20] < q25 /\
                q25 <= sum([toInt(b_ExplicitWithRepetition_Values[q27] = q20) | q27 : int(1..3), q27 <= 3]))
               ->
               a_MOccurrence[q20] = sum([toInt(b_ExplicitWithRepetition_Values[q24] = q20) | q24 : int(1..3), q24 <= 3])
                   | q20 : int(1..2), q25 : int(1..3), q20 < q19])))
            | q19 : int(1..2), q31 : int(1..3)]),
    3 = sum([a_MOccurrence[q1] | q1 : int(1..2)]),
    and([b_ExplicitWithRepetition_Values[q2] <= b_ExplicitWithRepetition_Values[q2 + 1] | q2 : int(1..2), q2 + 1 <= 3]),
    and([a_ExplicitWithRepetition_Values[q7] <= a_ExplicitWithRepetition_Values[q7 + 1] | q7 : int(1..2), q7 + 1 <= 3]),
    and([sum([toInt(a_ExplicitWithRepetition_Values[q15] = a_ExplicitWithRepetition_Values[q13])
                  | q15 : int(1..3), q15 <= 3])
         = a_MOccurrence[a_ExplicitWithRepetition_Values[q13]]
             | q13 : int(1..3), q13 <= 3]),
    and([a_MOccurrence[q16] > 0 ->
         sum([toInt(a_ExplicitWithRepetition_Values[q18] = q16) | q18 : int(1..3), q18 <= 3]) = a_MOccurrence[q16]
             | q16 : int(1..2)])

