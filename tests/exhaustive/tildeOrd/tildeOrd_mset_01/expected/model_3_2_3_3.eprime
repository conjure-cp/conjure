language ESSENCE' 1.0

find a_MOccurrence: matrix indexed by [int(1..2)] of int(0..3)
find b_ExplicitWithRepetition_Flag: int(3)
find b_ExplicitWithRepetition_Values: matrix indexed by [int(1..3)] of int(1..2)
find b_MOccurrence: matrix indexed by [int(1..2)] of int(0..3)
branching on [a_MOccurrence, b_MOccurrence, b_ExplicitWithRepetition_Flag, b_ExplicitWithRepetition_Values]
such that
    or([a_MOccurrence[q32] > 0 /\
        (a_MOccurrence[q32] < sum([toInt(b_ExplicitWithRepetition_Values[q18] = q32) | q18 : int(1..3), q18 <= 3]) /\
         (and([a_MOccurrence[q26] > 0 ->
               a_MOccurrence[q26] = sum([toInt(b_ExplicitWithRepetition_Values[q20] = q26) | q20 : int(1..3), q20 <= 3])
                   | q26 : int(1..2), q26 < q32])
          /\
          and([sum([toInt(b_ExplicitWithRepetition_Values[q25] = q16) | q25 : int(1..3), q25 <= 3]) > 0 /\
               (a_MOccurrence[q16] < q21 /\
                q21 <= sum([toInt(b_ExplicitWithRepetition_Values[q23] = q16) | q23 : int(1..3), q23 <= 3]))
               ->
               a_MOccurrence[q16] = sum([toInt(b_ExplicitWithRepetition_Values[q20] = q16) | q20 : int(1..3), q20 <= 3])
                   | q16 : int(1..2), q21 : int(1..3), q16 < q32])))
            | q32 : int(1..2)])
    \/
    or([sum([toInt(b_ExplicitWithRepetition_Values[q31] = q15) | q31 : int(1..3), q31 <= 3]) > 0 /\
        (a_MOccurrence[q15] < q27 /\
         q27 <= sum([toInt(b_ExplicitWithRepetition_Values[q29] = q15) | q29 : int(1..3), q29 <= 3]))
        /\
        (a_MOccurrence[q15] < sum([toInt(b_ExplicitWithRepetition_Values[q18] = q15) | q18 : int(1..3), q18 <= 3]) /\
         (and([a_MOccurrence[q26] > 0 ->
               a_MOccurrence[q26] = sum([toInt(b_ExplicitWithRepetition_Values[q20] = q26) | q20 : int(1..3), q20 <= 3])
                   | q26 : int(1..2), q26 < q15])
          /\
          and([sum([toInt(b_ExplicitWithRepetition_Values[q25] = q16) | q25 : int(1..3), q25 <= 3]) > 0 /\
               (a_MOccurrence[q16] < q21 /\
                q21 <= sum([toInt(b_ExplicitWithRepetition_Values[q23] = q16) | q23 : int(1..3), q23 <= 3]))
               ->
               a_MOccurrence[q16] = sum([toInt(b_ExplicitWithRepetition_Values[q20] = q16) | q20 : int(1..3), q20 <= 3])
                   | q16 : int(1..2), q21 : int(1..3), q16 < q15])))
            | q15 : int(1..2), q27 : int(1..3)]),
    3 = sum([a_MOccurrence[q1] | q1 : int(1..2)]),
    and([b_ExplicitWithRepetition_Values[q2] <= b_ExplicitWithRepetition_Values[q2 + 1] | q2 : int(1..2), q2 + 1 <= 3]),
    3 = sum([b_MOccurrence[q7] | q7 : int(1..2)]),
    and([b_MOccurrence[q9] > 0 ->
         b_MOccurrence[q9] = sum([toInt(b_ExplicitWithRepetition_Values[q11] = q9) | q11 : int(1..3), q11 <= 3])
             | q9 : int(1..2)]),
    and([b_MOccurrence[b_ExplicitWithRepetition_Values[q12]] =
         sum([toInt(b_ExplicitWithRepetition_Values[q14] = b_ExplicitWithRepetition_Values[q12])
                  | q14 : int(1..3), q14 <= 3])
             | q12 : int(1..3), q12 <= 3])

