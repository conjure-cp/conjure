                   | q34 : int(1..2), q39 : int(1..3), q34 < q50])))
            | q50 : int(1..2)])
    \/
    or([sum([toInt(b_ExplicitWithRepetition_Values[q49] = q33) | q49 : int(1..3), q49 <= 3]) > 0 /\
        (a_MOccurrence[q33] < q45 /\
         q45 <= sum([toInt(b_ExplicitWithRepetition_Values[q47] = q33) | q47 : int(1..3), q47 <= 3]))
        /\
        (a_MOccurrence[q33] < sum([toInt(b_ExplicitWithRepetition_Values[q36] = q33) | q36 : int(1..3), q36 <= 3]) /\
         (and([a_MOccurrence[q44] > 0 ->
               a_MOccurrence[q44] = sum([toInt(b_ExplicitWithRepetition_Values[q38] = q44) | q38 : int(1..3), q38 <= 3])
                   | q44 : int(1..2), q44 < q33])
          /\
          and([sum([toInt(b_ExplicitWithRepetition_Values[q43] = q34) | q43 : int(1..3), q43 <= 3]) > 0 /\
               (a_MOccurrence[q34] < q39 /\
