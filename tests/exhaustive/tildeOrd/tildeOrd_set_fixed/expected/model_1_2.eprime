language ESSENCE' 1.0

find a_Explicit: matrix indexed by [int(1)] of int(-2, 0, 3)
find b_Occurrence: matrix indexed by [int(-2, 0, 3)] of bool
find lt: bool
find leq: bool
branching on [a_Explicit, b_Occurrence, lt, leq]
such that
    lt <->
    toInt(a_Explicit[1] = a_Explicit[1]) < toInt(b_Occurrence[a_Explicit[1]]) /\
    ((a_Explicit[1] < a_Explicit[1] -> toInt(a_Explicit[1] = a_Explicit[1]) = toInt(b_Occurrence[a_Explicit[1]])) /\
     and([and([b_Occurrence[q5], !(a_Explicit[1] = q5), q5 < a_Explicit[1]; int(1..3)]) ->
          toInt(a_Explicit[1] = q5) = toInt(b_Occurrence[q5])
              | q5 : int(-2, 0, 3)]))
    \/
    or([b_Occurrence[q4] /\ !(a_Explicit[1] = q4) /\
        (toInt(a_Explicit[1] = q4) < toInt(b_Occurrence[q4]) /\
         ((a_Explicit[1] < q4 -> toInt(a_Explicit[1] = a_Explicit[1]) = toInt(b_Occurrence[a_Explicit[1]])) /\
          and([b_Occurrence[q5] /\ !(a_Explicit[1] = q5) -> toInt(a_Explicit[1] = q5) = toInt(b_Occurrence[q5])
                   | q5 : int(-2, 0, 3), q5 < q4])))
            | q4 : int(-2, 0, 3)]),
    leq <->
    b_Occurrence[a_Explicit[1]] /\ and([b_Occurrence[q29] -> a_Explicit[1] = q29 | q29 : int(-2, 0, 3)]) \/
    (toInt(a_Explicit[1] = a_Explicit[1]) < toInt(b_Occurrence[a_Explicit[1]]) /\
     ((a_Explicit[1] < a_Explicit[1] -> toInt(a_Explicit[1] = a_Explicit[1]) = toInt(b_Occurrence[a_Explicit[1]])) /\
      and([and([b_Occurrence[q33], !(a_Explicit[1] = q33), q33 < a_Explicit[1]; int(1..3)]) ->
           toInt(a_Explicit[1] = q33) = toInt(b_Occurrence[q33])
               | q33 : int(-2, 0, 3)]))
     \/
     or([b_Occurrence[q32] /\ !(a_Explicit[1] = q32) /\
         (toInt(a_Explicit[1] = q32) < toInt(b_Occurrence[q32]) /\
          ((a_Explicit[1] < q32 -> toInt(a_Explicit[1] = a_Explicit[1]) = toInt(b_Occurrence[a_Explicit[1]])) /\
           and([b_Occurrence[q33] /\ !(a_Explicit[1] = q33) -> toInt(a_Explicit[1] = q33) = toInt(b_Occurrence[q33])
                    | q33 : int(-2, 0, 3), q33 < q32])))
             | q32 : int(-2, 0, 3)])),
    1 = sum([toInt(b_Occurrence[q3]) | q3 : int(-2, 0, 3)])

