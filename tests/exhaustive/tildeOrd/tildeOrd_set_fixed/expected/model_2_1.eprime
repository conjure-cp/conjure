language ESSENCE' 1.0

find a_Occurrence: matrix indexed by [int(-2, 0, 3)] of bool
find b_Explicit: matrix indexed by [int(1)] of int(-2, 0, 3)
find lt: bool
find leq: bool
branching on [a_Occurrence, b_Explicit, lt, leq]
such that
    lt <->
    or([a_Occurrence[q4] /\
        (toInt(a_Occurrence[q4]) < toInt(b_Explicit[1] = q4) /\
         (and([a_Occurrence[q5] -> toInt(a_Occurrence[q5]) = toInt(b_Explicit[1] = q5) | q5 : int(-2, 0, 3), q5 < q4])
          /\
          (!or([a_Occurrence[q21] /\ q21 = b_Explicit[1] | q21 : int(-2, 0, 3)]) /\ b_Explicit[1] < q4 ->
           toInt(a_Occurrence[b_Explicit[1]]) = toInt(b_Explicit[1] = b_Explicit[1]))))
            | q4 : int(-2, 0, 3)])
    \/
    !or([a_Occurrence[q15] /\ q15 = b_Explicit[1] | q15 : int(-2, 0, 3)]) /\
    (toInt(a_Occurrence[b_Explicit[1]]) < toInt(b_Explicit[1] = b_Explicit[1]) /\
     (and([a_Occurrence[q5] /\ q5 < b_Explicit[1] -> toInt(a_Occurrence[q5]) = toInt(b_Explicit[1] = q5)
               | q5 : int(-2, 0, 3)])
      /\
      (!or([a_Occurrence[q12] /\ q12 = b_Explicit[1] | q12 : int(-2, 0, 3)]) /\ b_Explicit[1] < b_Explicit[1] ->
       toInt(a_Occurrence[b_Explicit[1]]) = toInt(b_Explicit[1] = b_Explicit[1])))),
    leq <->
    and([a_Occurrence[q24] -> b_Explicit[1] = q24 | q24 : int(-2, 0, 3)]) /\ a_Occurrence[b_Explicit[1]] \/
    (or([a_Occurrence[q29] /\
         (toInt(a_Occurrence[q29]) < toInt(b_Explicit[1] = q29) /\
          (and([a_Occurrence[q30] -> toInt(a_Occurrence[q30]) = toInt(b_Explicit[1] = q30)
                    | q30 : int(-2, 0, 3), q30 < q29])
           /\
           (!or([a_Occurrence[q46] /\ q46 = b_Explicit[1] | q46 : int(-2, 0, 3)]) /\ b_Explicit[1] < q29 ->
            toInt(a_Occurrence[b_Explicit[1]]) = toInt(b_Explicit[1] = b_Explicit[1]))))
             | q29 : int(-2, 0, 3)])
     \/
     !or([a_Occurrence[q40] /\ q40 = b_Explicit[1] | q40 : int(-2, 0, 3)]) /\
     (toInt(a_Occurrence[b_Explicit[1]]) < toInt(b_Explicit[1] = b_Explicit[1]) /\
      (and([a_Occurrence[q30] /\ q30 < b_Explicit[1] -> toInt(a_Occurrence[q30]) = toInt(b_Explicit[1] = q30)
                | q30 : int(-2, 0, 3)])
       /\
       (!or([a_Occurrence[q37] /\ q37 = b_Explicit[1] | q37 : int(-2, 0, 3)]) /\ b_Explicit[1] < b_Explicit[1] ->
        toInt(a_Occurrence[b_Explicit[1]]) = toInt(b_Explicit[1] = b_Explicit[1]))))),
    1 = sum([toInt(a_Occurrence[q1]) | q1 : int(-2, 0, 3)])

