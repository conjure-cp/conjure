language ESSENCE' 1.0

find a_RelationAsMatrix: matrix indexed by [int(1..2), bool] of bool
find b_RelationAsMatrix: matrix indexed by [int(1..2), bool] of bool
branching on [a_RelationAsMatrix, b_RelationAsMatrix]
such that
    or([b_RelationAsMatrix[q8_1, q8_2] /\
        (sum([toInt(a_RelationAsMatrix[q17_1, q17_2]) * catchUndef(toInt(q17_1 = q8_1 /\ q17_2 = q8_2), 0)
                  | q17_1 : int(1..2), q17_2 : bool])
         <
         sum([toInt(b_RelationAsMatrix[q10_1, q10_2]) * catchUndef(toInt(q10_1 = q8_1 /\ q10_2 = q8_2), 0)
                  | q10_1 : int(1..2), q10_2 : bool])
         /\
         and([a_RelationAsMatrix[q11_1, q11_2] ->
              sum([toInt(a_RelationAsMatrix[q15_1, q15_2]) * catchUndef(toInt(q15_1 = q11_1 /\ q15_2 = q11_2), 0)
                       | q15_1 : int(1..2), q15_2 : bool])
              =
              sum([toInt(b_RelationAsMatrix[q13_1, q13_2]) * catchUndef(toInt(q13_1 = q11_1 /\ q13_2 = q11_2), 0)
                       | q13_1 : int(1..2), q13_2 : bool])
                  | q11_1 : int(1..2), q11_2 : bool, q11_1 < q8_1 \/ q11_1 = q8_1 /\ q11_2 < q8_2])
         /\
         and([b_RelationAsMatrix[q18_1, q18_2] ->
              sum([toInt(a_RelationAsMatrix[q22_1, q22_2]) * catchUndef(toInt(q22_1 = q18_1 /\ q22_2 = q18_2), 0)
                       | q22_1 : int(1..2), q22_2 : bool])
              =
              sum([toInt(b_RelationAsMatrix[q20_1, q20_2]) * catchUndef(toInt(q20_1 = q18_1 /\ q20_2 = q18_2), 0)
                       | q20_1 : int(1..2), q20_2 : bool])
                  | q18_1 : int(1..2), q18_2 : bool, q18_1 < q8_1 \/ q18_1 = q8_1 /\ q18_2 < q8_2]))
            | q8_1 : int(1..2), q8_2 : bool])

