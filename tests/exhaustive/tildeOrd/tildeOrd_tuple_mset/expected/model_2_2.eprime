language ESSENCE' 1.0

find a_ExplicitWithRepetition_Flag: int(0..2)
find a_ExplicitWithRepetition_Values_1: matrix indexed by [int(1..2)] of int(1)
find a_ExplicitWithRepetition_Values_2: matrix indexed by [int(1..2)] of int(1..2)
find b_ExplicitWithRepetition_Flag: int(0..2)
find b_ExplicitWithRepetition_Values_1: matrix indexed by [int(1..2)] of int(1)
find b_ExplicitWithRepetition_Values_2: matrix indexed by [int(1..2)] of int(1..2)
find lt: bool
find leq: bool
branching on
    [a_ExplicitWithRepetition_Flag, a_ExplicitWithRepetition_Values_1, a_ExplicitWithRepetition_Values_2,
     b_ExplicitWithRepetition_Flag, b_ExplicitWithRepetition_Values_1, b_ExplicitWithRepetition_Values_2, lt, leq]
such that
    lt <->
    flatten([flatten([[toInt(q11 <= a_ExplicitWithRepetition_Flag); int(1)],
                      flatten([[-a_ExplicitWithRepetition_Values_1[q11] * toInt(q11 <= a_ExplicitWithRepetition_Flag);
                                    int(1)],
                               [-a_ExplicitWithRepetition_Values_2[q11] * toInt(q11 <= a_ExplicitWithRepetition_Flag);
                                    int(1)];
                                   int(1..2)]);
                          int(1..2)])
                 | q11 : int(1..2)])
    <lex
    flatten([flatten([[toInt(q12 <= b_ExplicitWithRepetition_Flag); int(1)],
                      flatten([[-b_ExplicitWithRepetition_Values_1[q12] * toInt(q12 <= b_ExplicitWithRepetition_Flag);
                                    int(1)],
                               [-b_ExplicitWithRepetition_Values_2[q12] * toInt(q12 <= b_ExplicitWithRepetition_Flag);
                                    int(1)];
                                   int(1..2)]);
                          int(1..2)])
                 | q12 : int(1..2)]),
    leq <->
    flatten([flatten([[toInt(q13 <= a_ExplicitWithRepetition_Flag); int(1)],
                      flatten([[-a_ExplicitWithRepetition_Values_1[q13] * toInt(q13 <= a_ExplicitWithRepetition_Flag);
                                    int(1)],
                               [-a_ExplicitWithRepetition_Values_2[q13] * toInt(q13 <= a_ExplicitWithRepetition_Flag);
                                    int(1)];
                                   int(1..2)]);
                          int(1..2)])
                 | q13 : int(1..2)])
    <=lex
    flatten([flatten([[toInt(q14 <= b_ExplicitWithRepetition_Flag); int(1)],
                      flatten([[-b_ExplicitWithRepetition_Values_1[q14] * toInt(q14 <= b_ExplicitWithRepetition_Flag);
                                    int(1)],
                               [-b_ExplicitWithRepetition_Values_2[q14] * toInt(q14 <= b_ExplicitWithRepetition_Flag);
                                    int(1)];
                                   int(1..2)]);
                          int(1..2)])
                 | q14 : int(1..2)]),
    2 <= a_ExplicitWithRepetition_Flag ->
    flatten([[a_ExplicitWithRepetition_Values_1[1]; int(1)], [a_ExplicitWithRepetition_Values_2[1]; int(1)]; int(1..2)])
    <=lex
    flatten([[a_ExplicitWithRepetition_Values_1[2]; int(1)], [a_ExplicitWithRepetition_Values_2[2]; int(1)];
                 int(1..2)]),
    and([q2 > a_ExplicitWithRepetition_Flag ->
         a_ExplicitWithRepetition_Values_1[q2] = 1 /\ a_ExplicitWithRepetition_Values_2[q2] = 1
             | q2 : int(1..2)]),
    a_ExplicitWithRepetition_Flag <= 2,
    2 <= b_ExplicitWithRepetition_Flag ->
    flatten([[b_ExplicitWithRepetition_Values_1[1]; int(1)], [b_ExplicitWithRepetition_Values_2[1]; int(1)]; int(1..2)])
    <=lex
    flatten([[b_ExplicitWithRepetition_Values_1[2]; int(1)], [b_ExplicitWithRepetition_Values_2[2]; int(1)];
                 int(1..2)]),
    and([q7 > b_ExplicitWithRepetition_Flag ->
         b_ExplicitWithRepetition_Values_1[q7] = 1 /\ b_ExplicitWithRepetition_Values_2[q7] = 1
             | q7 : int(1..2)]),
    b_ExplicitWithRepetition_Flag <= 2

