language ESSENCE' 1.0

find a_ExplicitWithFlags_Flags: matrix indexed by [int(1..2)] of int(0..2)
find a_ExplicitWithFlags_Values_1: matrix indexed by [int(1..2)] of int(1)
find a_ExplicitWithFlags_Values_2: matrix indexed by [int(1..2)] of int(1..2)
find b_ExplicitWithFlags_Flags: matrix indexed by [int(1..2)] of int(0..2)
find b_ExplicitWithFlags_Values_1: matrix indexed by [int(1..2)] of int(1)
find b_ExplicitWithFlags_Values_2: matrix indexed by [int(1..2)] of int(1..2)
find lt: bool
find leq: bool
branching on
    [a_ExplicitWithFlags_Flags, a_ExplicitWithFlags_Values_1, a_ExplicitWithFlags_Values_2, b_ExplicitWithFlags_Flags,
     b_ExplicitWithFlags_Values_1, b_ExplicitWithFlags_Values_2, lt, leq]
such that
    lt <->
    flatten([flatten([[toInt(a_ExplicitWithFlags_Flags[q13] > 0); int(1)],
                      flatten([[-a_ExplicitWithFlags_Values_1[q13] * toInt(a_ExplicitWithFlags_Flags[q13] > 0); int(1)],
                               [-a_ExplicitWithFlags_Values_2[q13] * toInt(a_ExplicitWithFlags_Flags[q13] > 0); int(1)];
                                   int(1..2)]),
                      [a_ExplicitWithFlags_Flags[q13]; int(1)];
                          int(1..3)])
                 | q13 : int(1..2)])
    <lex
    flatten([flatten([[toInt(b_ExplicitWithFlags_Flags[q14] > 0); int(1)],
                      flatten([[-b_ExplicitWithFlags_Values_1[q14] * toInt(b_ExplicitWithFlags_Flags[q14] > 0); int(1)],
                               [-b_ExplicitWithFlags_Values_2[q14] * toInt(b_ExplicitWithFlags_Flags[q14] > 0); int(1)];
                                   int(1..2)]),
                      [b_ExplicitWithFlags_Flags[q14]; int(1)];
                          int(1..3)])
                 | q14 : int(1..2)]),
    leq <->
    flatten([flatten([[toInt(a_ExplicitWithFlags_Flags[q15] > 0); int(1)],
                      flatten([[-a_ExplicitWithFlags_Values_1[q15] * toInt(a_ExplicitWithFlags_Flags[q15] > 0); int(1)],
                               [-a_ExplicitWithFlags_Values_2[q15] * toInt(a_ExplicitWithFlags_Flags[q15] > 0); int(1)];
                                   int(1..2)]),
                      [a_ExplicitWithFlags_Flags[q15]; int(1)];
                          int(1..3)])
                 | q15 : int(1..2)])
    <=lex
    flatten([flatten([[toInt(b_ExplicitWithFlags_Flags[q16] > 0); int(1)],
                      flatten([[-b_ExplicitWithFlags_Values_1[q16] * toInt(b_ExplicitWithFlags_Flags[q16] > 0); int(1)],
                               [-b_ExplicitWithFlags_Values_2[q16] * toInt(b_ExplicitWithFlags_Flags[q16] > 0); int(1)];
                                   int(1..2)]),
                      [b_ExplicitWithFlags_Flags[q16]; int(1)];
                          int(1..3)])
                 | q16 : int(1..2)]),
    a_ExplicitWithFlags_Flags[2] > 0 ->
    flatten([[a_ExplicitWithFlags_Values_1[1]; int(1)], [a_ExplicitWithFlags_Values_2[1]; int(1)]; int(1..2)]) <lex
    flatten([[a_ExplicitWithFlags_Values_1[2]; int(1)], [a_ExplicitWithFlags_Values_2[2]; int(1)]; int(1..2)]),
    and([a_ExplicitWithFlags_Flags[q2] = 0 ->
         a_ExplicitWithFlags_Values_1[q2] = 1 /\ a_ExplicitWithFlags_Values_2[q2] = 1
             | q2 : int(1..2)]),
    a_ExplicitWithFlags_Flags[2] > 0 -> a_ExplicitWithFlags_Flags[1] > 0,
    sum([a_ExplicitWithFlags_Flags[q5] | q5 : int(1..2)]) <= 2,
    b_ExplicitWithFlags_Flags[2] > 0 ->
    flatten([[b_ExplicitWithFlags_Values_1[1]; int(1)], [b_ExplicitWithFlags_Values_2[1]; int(1)]; int(1..2)]) <lex
    flatten([[b_ExplicitWithFlags_Values_1[2]; int(1)], [b_ExplicitWithFlags_Values_2[2]; int(1)]; int(1..2)]),
    and([b_ExplicitWithFlags_Flags[q8] = 0 ->
         b_ExplicitWithFlags_Values_1[q8] = 1 /\ b_ExplicitWithFlags_Values_2[q8] = 1
             | q8 : int(1..2)]),
    b_ExplicitWithFlags_Flags[2] > 0 -> b_ExplicitWithFlags_Flags[1] > 0,
    sum([b_ExplicitWithFlags_Flags[q11] | q11 : int(1..2)]) <= 2

