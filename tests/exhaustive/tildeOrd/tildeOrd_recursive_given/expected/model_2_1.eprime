language ESSENCE' 1.0

given p_ExplicitR3_Explicit: matrix indexed by [int(1..2), int(1)] of int(1..3)
find a_ExplicitR2_Occurrence: matrix indexed by [int(1..2), int(1..3)] of bool
branching on [a_ExplicitR2_Occurrence]
such that
    and([or([a_ExplicitR2_Occurrence[q7, p_ExplicitR3_Explicit[q9, 1]] /\
             and([a_ExplicitR2_Occurrence[q7, q12] -> p_ExplicitR3_Explicit[q9, 1] = q12 | q12 : int(1..3)])
                 | q9 : int(1..2)])
             | q7 : int(1..2)]),
    and([or([and([a_ExplicitR2_Occurrence[q18, q19] -> p_ExplicitR3_Explicit[q16, 1] = q19 | q19 : int(1..3)]) /\
             a_ExplicitR2_Occurrence[q18, p_ExplicitR3_Explicit[q16, 1]]
                 | q18 : int(1..2)])
             | q16 : int(1..2)]),
    [toInt(a_ExplicitR2_Occurrence[1, q4]) | q4 : int(1..3)] <lex
    [toInt(a_ExplicitR2_Occurrence[2, q5]) | q5 : int(1..3)],
    and([1 = sum([toInt(a_ExplicitR2_Occurrence[q2, q3]) | q3 : int(1..3)]) | q2 : int(1..2)])

