language ESSENCE' 1.0

given p_ExplicitR2_Occurrence: matrix indexed by [int(1..2), int(1..3)] of bool
find a_ExplicitR3_Explicit: matrix indexed by [int(1..2), int(1)] of int(1..3)
branching on [a_ExplicitR3_Explicit]
such that
    and([or([and([a_ExplicitR3_Explicit[q8, 1] = q11 | q11 : int(1..3), p_ExplicitR2_Occurrence[q10, q11]]) /\
             p_ExplicitR2_Occurrence[q10, a_ExplicitR3_Explicit[q8, 1]]
                 | q10 : int(1..2)])
             | q8 : int(1..2)]),
    and([or([p_ExplicitR2_Occurrence[q17, a_ExplicitR3_Explicit[q19, 1]] /\
             and([a_ExplicitR3_Explicit[q19, 1] = q22 | q22 : int(1..3), p_ExplicitR2_Occurrence[q17, q22]])
                 | q19 : int(1..2)])
             | q17 : int(1..2)]),
    -a_ExplicitR3_Explicit[1, 1] < -a_ExplicitR3_Explicit[2, 1]

