                                    int(1)];
                                   int(1..2)]);
                          int(1..2)])
                 | q10 : int(1..2)]),
    2 <= a_ExplicitVarSizeWithMarker_Marker ->
    flatten([[a_ExplicitVarSizeWithMarker_Values_1[1]; int(1)], [a_ExplicitVarSizeWithMarker_Values_2[1]; int(1)];
