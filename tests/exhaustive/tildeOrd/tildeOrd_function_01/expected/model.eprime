language ESSENCE' 1.0

find a_Function1DPartial_Flags: matrix indexed by [int(1..2)] of bool
find a_Function1DPartial_Values: matrix indexed by [int(1..2)] of bool
find b_Function1DPartial_Flags: matrix indexed by [int(1..2)] of bool
find b_Function1DPartial_Values: matrix indexed by [int(1..2)] of bool
branching on
    [a_Function1DPartial_Flags, a_Function1DPartial_Values, b_Function1DPartial_Flags, b_Function1DPartial_Values]
such that
    or([b_Function1DPartial_Flags[q10] /\
        (sum([toInt(a_Function1DPartial_Flags[q17]) *
              catchUndef(toInt(q17 = q10 /\ a_Function1DPartial_Values[q17] = b_Function1DPartial_Values[q10]), 0)
                  | q17 : int(1..2)])
         <
         sum([toInt(b_Function1DPartial_Flags[q19]) *
              catchUndef(toInt(q19 = q10 /\ b_Function1DPartial_Values[q19] = b_Function1DPartial_Values[q10]), 0)
                  | q19 : int(1..2)])
         /\
         and([a_Function1DPartial_Flags[q11] /\
              (q11 < q10 \/ q11 = q10 /\ a_Function1DPartial_Values[q11] < b_Function1DPartial_Values[q10])
              ->
              sum([toInt(a_Function1DPartial_Flags[q13]) *
                   catchUndef(toInt(q13 = q11 /\ a_Function1DPartial_Values[q13] = a_Function1DPartial_Values[q11]), 0)
                       | q13 : int(1..2)])
              =
              sum([toInt(b_Function1DPartial_Flags[q15]) *
                   catchUndef(toInt(q15 = q11 /\ b_Function1DPartial_Values[q15] = a_Function1DPartial_Values[q11]), 0)
                       | q15 : int(1..2)])
                  | q11 : int(1..2)])
         /\
         and([b_Function1DPartial_Flags[q20] /\
              (q20 < q10 \/ q20 = q10 /\ b_Function1DPartial_Values[q20] < b_Function1DPartial_Values[q10])
              ->
              sum([toInt(a_Function1DPartial_Flags[q22]) *
                   catchUndef(toInt(q22 = q20 /\ a_Function1DPartial_Values[q22] = b_Function1DPartial_Values[q20]), 0)
                       | q22 : int(1..2)])
              =
              sum([toInt(b_Function1DPartial_Flags[q24]) *
                   catchUndef(toInt(q24 = q20 /\ b_Function1DPartial_Values[q24] = b_Function1DPartial_Values[q20]), 0)
                       | q24 : int(1..2)])
                  | q20 : int(1..2)]))
            | q10 : int(1..2)]),
    and([a_Function1DPartial_Flags[q1] = false -> a_Function1DPartial_Values[q1] = false | q1 : int(1..2)]),
    and([b_Function1DPartial_Flags[q4] = false -> b_Function1DPartial_Values[q4] = false | q4 : int(1..2)])

