language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithRepetitionR3_Flag: int(fin1)
given p_ExplicitWithRepetitionR3_Values_Explicit: matrix indexed by [int(1..fin1), int(1)] of int(1..2)
find a_ExplicitWithRepetitionR2_Flag: int(0..3)
find a_ExplicitWithRepetitionR2_Values_Occurrence: matrix indexed by [int(1..3), int(1..2)] of bool
branching on [a_ExplicitWithRepetitionR2_Flag, a_ExplicitWithRepetitionR2_Values_Occurrence]
such that
    and([q11 <= a_ExplicitWithRepetitionR2_Flag ->
         sum([toInt(q13 <= a_ExplicitWithRepetitionR2_Flag) *
              catchUndef(toInt(and([a_ExplicitWithRepetitionR2_Values_Occurrence[q13, q14] =
                                    a_ExplicitWithRepetitionR2_Values_Occurrence[q11, q14]
                                        | q14 : int(1..2)])),
                         0)
                  | q13 : int(1..3)])
         =
         sum([toInt(a_ExplicitWithRepetitionR2_Values_Occurrence
                        [q11, p_ExplicitWithRepetitionR3_Values_Explicit[q17, 1]]
                    /\
                    and([a_ExplicitWithRepetitionR2_Values_Occurrence[q11, q20] ->
                         p_ExplicitWithRepetitionR3_Values_Explicit[q17, 1] = q20
                             | q20 : int(1..2)]))
                  | q17 : int(1..fin1), q17 <= fin1])
             | q11 : int(1..3)]),
    and([sum([toInt(q25 <= a_ExplicitWithRepetitionR2_Flag) *
              catchUndef(toInt(and([a_ExplicitWithRepetitionR2_Values_Occurrence[q25, q26] ->
                                    p_ExplicitWithRepetitionR3_Values_Explicit[q23, 1] = q26
                                        | q26 : int(1..2)])
                               /\
                               a_ExplicitWithRepetitionR2_Values_Occurrence
                                   [q25, p_ExplicitWithRepetitionR3_Values_Explicit[q23, 1]]),
                         0)
                  | q25 : int(1..3)])
         =
         sum([toInt(p_ExplicitWithRepetitionR3_Values_Explicit[q32, 1] =
                    p_ExplicitWithRepetitionR3_Values_Explicit[q23, 1])
                  | q32 : int(1..fin1), q32 <= fin1])
             | q23 : int(1..fin1), q23 <= fin1]),
    and([q1 + 1 <= a_ExplicitWithRepetitionR2_Flag ->
         [toInt(a_ExplicitWithRepetitionR2_Values_Occurrence[q1, q7]) | q7 : int(1..2)] <=lex
         [toInt(a_ExplicitWithRepetitionR2_Values_Occurrence[q1 + 1, q8]) | q8 : int(1..2)]
             | q1 : int(1..2)]),
    and([q2 > a_ExplicitWithRepetitionR2_Flag ->
         and([a_ExplicitWithRepetitionR2_Values_Occurrence[q2, q9] = false | q9 : int(1..2)])
             | q2 : int(1..3)]),
    a_ExplicitWithRepetitionR2_Flag <= 3,
    and([q5 <= a_ExplicitWithRepetitionR2_Flag ->
         1 = sum([toInt(a_ExplicitWithRepetitionR2_Values_Occurrence[q5, q6]) | q6 : int(1..2)])
             | q5 : int(1..3)])

