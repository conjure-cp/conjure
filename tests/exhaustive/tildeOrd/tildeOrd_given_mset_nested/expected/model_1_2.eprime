language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithFlagsR2_Flags: matrix indexed by [int(1..fin1)] of int(0..fin1)
given p_ExplicitWithFlagsR2_Values_Occurrence: matrix indexed by [int(1..fin1), int(1..2)] of bool
find a_ExplicitWithFlagsR3_Flags: matrix indexed by [int(1..3)] of int(0..3)
find a_ExplicitWithFlagsR3_Values_Explicit: matrix indexed by [int(1..3), int(1)] of int(1..2)
branching on [a_ExplicitWithFlagsR3_Flags, a_ExplicitWithFlagsR3_Values_Explicit]
such that
    and([a_ExplicitWithFlagsR3_Flags[q13] > 0 ->
         sum([toInt(a_ExplicitWithFlagsR3_Values_Explicit[q14, 1] = a_ExplicitWithFlagsR3_Values_Explicit[q13, 1]) *
              catchUndef(a_ExplicitWithFlagsR3_Flags[q14], 0)
                  | q14 : int(1..3)])
         =
         sum([toInt(and([a_ExplicitWithFlagsR3_Values_Explicit[q13, 1] = q18
                             | q18 : int(1..2), p_ExplicitWithFlagsR2_Values_Occurrence[q17, q18]])
                    /\ p_ExplicitWithFlagsR2_Values_Occurrence[q17, a_ExplicitWithFlagsR3_Values_Explicit[q13, 1]])
              * catchUndef(p_ExplicitWithFlagsR2_Flags[q17], 0)
                  | q17 : int(1..fin1)])
             | q13 : int(1..3)]),
    and([sum([toInt(p_ExplicitWithFlagsR2_Values_Occurrence[q23, a_ExplicitWithFlagsR3_Values_Explicit[q24, 1]] /\
                    and([a_ExplicitWithFlagsR3_Values_Explicit[q24, 1] = q27
                             | q27 : int(1..2), p_ExplicitWithFlagsR2_Values_Occurrence[q23, q27]]))
              * catchUndef(a_ExplicitWithFlagsR3_Flags[q24], 0)
                  | q24 : int(1..3)])
         =
         sum([p_ExplicitWithFlagsR2_Flags[q30]
                  | q30 : int(1..fin1),
                    and([p_ExplicitWithFlagsR2_Values_Occurrence[q30, q31] =
                         p_ExplicitWithFlagsR2_Values_Occurrence[q23, q31]
                             | q31 : int(1..2)])])
             | q23 : int(1..fin1), p_ExplicitWithFlagsR2_Flags[q23] > 0]),
    and([a_ExplicitWithFlagsR3_Flags[q1 + 1] > 0 ->
         -a_ExplicitWithFlagsR3_Values_Explicit[q1, 1] < -a_ExplicitWithFlagsR3_Values_Explicit[q1 + 1, 1]
             | q1 : int(1..2)]),
    and([a_ExplicitWithFlagsR3_Flags[q2] = 0 -> a_ExplicitWithFlagsR3_Values_Explicit[q2, 1] = 1 | q2 : int(1..3)]),
    and([a_ExplicitWithFlagsR3_Flags[q3 + 1] > 0 -> a_ExplicitWithFlagsR3_Flags[q3] > 0 | q3 : int(1..2)]),
    sum([a_ExplicitWithFlagsR3_Flags[q5] | q5 : int(1..3)]) <= 3

