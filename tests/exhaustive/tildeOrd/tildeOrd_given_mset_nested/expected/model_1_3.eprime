language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithRepetitionR3_Flag: int(fin1)
given p_ExplicitWithRepetitionR3_Values_Explicit: matrix indexed by [int(1..fin1), int(1)] of int(1..2)
find a_ExplicitWithFlagsR3_Flags: matrix indexed by [int(1..3)] of int(0..3)
find a_ExplicitWithFlagsR3_Values_Explicit: matrix indexed by [int(1..3), int(1)] of int(1..2)
branching on [a_ExplicitWithFlagsR3_Flags, a_ExplicitWithFlagsR3_Values_Explicit]
such that
    and([a_ExplicitWithFlagsR3_Flags[q13] > 0 ->
         sum([toInt(a_ExplicitWithFlagsR3_Values_Explicit[q14, 1] = a_ExplicitWithFlagsR3_Values_Explicit[q13, 1]) *
              catchUndef(a_ExplicitWithFlagsR3_Flags[q14], 0)
                  | q14 : int(1..3)])
         =
         sum([toInt(p_ExplicitWithRepetitionR3_Values_Explicit[q18, 1] = a_ExplicitWithFlagsR3_Values_Explicit[q13, 1])
                  | q18 : int(1..fin1), q18 <= fin1])
             | q13 : int(1..3)]),
    and([sum([toInt(a_ExplicitWithFlagsR3_Values_Explicit[q22, 1] = p_ExplicitWithRepetitionR3_Values_Explicit[q21, 1])
              * catchUndef(a_ExplicitWithFlagsR3_Flags[q22], 0)
                  | q22 : int(1..3)])
         =
         sum([toInt(p_ExplicitWithRepetitionR3_Values_Explicit[q26, 1] =
                    p_ExplicitWithRepetitionR3_Values_Explicit[q21, 1])
                  | q26 : int(1..fin1), q26 <= fin1])
             | q21 : int(1..fin1), q21 <= fin1]),
    and([a_ExplicitWithFlagsR3_Flags[q1 + 1] > 0 ->
         -a_ExplicitWithFlagsR3_Values_Explicit[q1, 1] < -a_ExplicitWithFlagsR3_Values_Explicit[q1 + 1, 1]
             | q1 : int(1..2)]),
    and([a_ExplicitWithFlagsR3_Flags[q2] = 0 -> a_ExplicitWithFlagsR3_Values_Explicit[q2, 1] = 1 | q2 : int(1..3)]),
    and([a_ExplicitWithFlagsR3_Flags[q3 + 1] > 0 -> a_ExplicitWithFlagsR3_Flags[q3] > 0 | q3 : int(1..2)]),
    sum([a_ExplicitWithFlagsR3_Flags[q5] | q5 : int(1..3)]) <= 3

