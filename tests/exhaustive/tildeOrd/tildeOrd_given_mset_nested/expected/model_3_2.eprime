language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithFlagsR2_Flags: matrix indexed by [int(1..fin1)] of int(0..fin1)
given p_ExplicitWithFlagsR2_Values_Occurrence: matrix indexed by [int(1..fin1), int(1..2)] of bool
find a_ExplicitWithRepetitionR3_Flag: int(0..3)
find a_ExplicitWithRepetitionR3_Values_Explicit: matrix indexed by [int(1..3), int(1)] of int(1..2)
branching on [a_ExplicitWithRepetitionR3_Flag, a_ExplicitWithRepetitionR3_Values_Explicit]
such that
    and([q12 <= a_ExplicitWithRepetitionR3_Flag ->
         sum([toInt(q20 <= a_ExplicitWithRepetitionR3_Flag) *
              catchUndef(toInt(a_ExplicitWithRepetitionR3_Values_Explicit[q20, 1] =
                               a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1]),
                         0)
                  | q20 : int(1..3)])
         =
         sum([toInt(and([a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1] = q14
                             | q14 : int(1..2), p_ExplicitWithFlagsR2_Values_Occurrence[q13, q14]])
                    /\ p_ExplicitWithFlagsR2_Values_Occurrence[q13, a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1]])
              * catchUndef(p_ExplicitWithFlagsR2_Flags[q13], 0)
                  | q13 : int(1..fin1)])
             | q12 : int(1..3)]),
    and([sum([toInt(q28 <= a_ExplicitWithRepetitionR3_Flag) *
              catchUndef(toInt(p_ExplicitWithFlagsR2_Values_Occurrence
                                   [q23, a_ExplicitWithRepetitionR3_Values_Explicit[q28, 1]]
                               /\
                               and([a_ExplicitWithRepetitionR3_Values_Explicit[q28, 1] = q31
                                        | q31 : int(1..2), p_ExplicitWithFlagsR2_Values_Occurrence[q23, q31]])),
                         0)
                  | q28 : int(1..3)])
         =
         sum([p_ExplicitWithFlagsR2_Flags[q24]
                  | q24 : int(1..fin1),
                    and([p_ExplicitWithFlagsR2_Values_Occurrence[q24, q25] =
                         p_ExplicitWithFlagsR2_Values_Occurrence[q23, q25]
                             | q25 : int(1..2)])])
             | q23 : int(1..fin1), p_ExplicitWithFlagsR2_Flags[q23] > 0]),
    and([q1 + 1 <= a_ExplicitWithRepetitionR3_Flag ->
         -a_ExplicitWithRepetitionR3_Values_Explicit[q1, 1] <= -a_ExplicitWithRepetitionR3_Values_Explicit[q1 + 1, 1]
             | q1 : int(1..2)]),
    and([q2 > a_ExplicitWithRepetitionR3_Flag -> a_ExplicitWithRepetitionR3_Values_Explicit[q2, 1] = 1
             | q2 : int(1..3)]),
    a_ExplicitWithRepetitionR3_Flag <= 3

