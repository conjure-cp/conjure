language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithRepetitionR2_Flag: int(fin1)
given p_ExplicitWithRepetitionR2_Values_Occurrence: matrix indexed by [int(1..fin1), int(1..2)] of bool
find a_ExplicitWithRepetitionR3_Flag: int(0..3)
find a_ExplicitWithRepetitionR3_Values_Explicit: matrix indexed by [int(1..3), int(1)] of int(1..2)
branching on [a_ExplicitWithRepetitionR3_Flag, a_ExplicitWithRepetitionR3_Values_Explicit]
such that
    and([q12 <= a_ExplicitWithRepetitionR3_Flag ->
         sum([toInt(q14 <= a_ExplicitWithRepetitionR3_Flag) *
              catchUndef(toInt(a_ExplicitWithRepetitionR3_Values_Explicit[q14, 1] =
                               a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1]),
                         0)
                  | q14 : int(1..3)])
         =
         sum([toInt(and([a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1] = q19
                             | q19 : int(1..2), p_ExplicitWithRepetitionR2_Values_Occurrence[q18, q19]])
                    /\
                    p_ExplicitWithRepetitionR2_Values_Occurrence
                        [q18, a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1]])
                  | q18 : int(1..fin1), q18 <= fin1])
             | q12 : int(1..3)]),
    and([sum([toInt(q26 <= a_ExplicitWithRepetitionR3_Flag) *
              catchUndef(toInt(p_ExplicitWithRepetitionR2_Values_Occurrence
                                   [q24, a_ExplicitWithRepetitionR3_Values_Explicit[q26, 1]]
                               /\
                               and([a_ExplicitWithRepetitionR3_Values_Explicit[q26, 1] = q29
                                        | q29 : int(1..2), p_ExplicitWithRepetitionR2_Values_Occurrence[q24, q29]])),
                         0)
                  | q26 : int(1..3)])
         =
         sum([toInt(and([p_ExplicitWithRepetitionR2_Values_Occurrence[q33, q34] =
                         p_ExplicitWithRepetitionR2_Values_Occurrence[q24, q34]
                             | q34 : int(1..2)]))
                  | q33 : int(1..fin1), q33 <= fin1])
             | q24 : int(1..fin1), q24 <= fin1]),
    and([q1 + 1 <= a_ExplicitWithRepetitionR3_Flag ->
         -a_ExplicitWithRepetitionR3_Values_Explicit[q1, 1] <= -a_ExplicitWithRepetitionR3_Values_Explicit[q1 + 1, 1]
             | q1 : int(1..2)]),
    and([q2 > a_ExplicitWithRepetitionR3_Flag -> a_ExplicitWithRepetitionR3_Values_Explicit[q2, 1] = 1
             | q2 : int(1..3)]),
    a_ExplicitWithRepetitionR3_Flag <= 3

