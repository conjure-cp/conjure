language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithFlagsR3_Flags: matrix indexed by [int(1..fin1)] of int(0..fin1)
given p_ExplicitWithFlagsR3_Values_Explicit: matrix indexed by [int(1..fin1), int(1)] of int(1..2)
find a_ExplicitWithFlagsR2_Flags: matrix indexed by [int(1..3)] of int(0..3)
find a_ExplicitWithFlagsR2_Values_Occurrence: matrix indexed by [int(1..3), int(1..2)] of bool
branching on [a_ExplicitWithFlagsR2_Flags, a_ExplicitWithFlagsR2_Values_Occurrence]
such that
    and([a_ExplicitWithFlagsR2_Flags[q12] > 0 ->
         sum([toInt(and([a_ExplicitWithFlagsR2_Values_Occurrence[q13, q14] =
                         a_ExplicitWithFlagsR2_Values_Occurrence[q12, q14]
                             | q14 : int(1..2)]))
              * catchUndef(a_ExplicitWithFlagsR2_Flags[q13], 0)
                  | q13 : int(1..3)])
         =
         sum([toInt(a_ExplicitWithFlagsR2_Values_Occurrence[q12, p_ExplicitWithFlagsR3_Values_Explicit[q16, 1]] /\
                    and([a_ExplicitWithFlagsR2_Values_Occurrence[q12, q19] ->
                         p_ExplicitWithFlagsR3_Values_Explicit[q16, 1] = q19
                             | q19 : int(1..2)]))
              * catchUndef(p_ExplicitWithFlagsR3_Flags[q16], 0)
                  | q16 : int(1..fin1)])
             | q12 : int(1..3)]),
    and([sum([toInt(and([a_ExplicitWithFlagsR2_Values_Occurrence[q23, q24] ->
                         p_ExplicitWithFlagsR3_Values_Explicit[q22, 1] = q24
                             | q24 : int(1..2)])
                    /\ a_ExplicitWithFlagsR2_Values_Occurrence[q23, p_ExplicitWithFlagsR3_Values_Explicit[q22, 1]])
              * catchUndef(a_ExplicitWithFlagsR2_Flags[q23], 0)
                  | q23 : int(1..3)])
         =
         sum([p_ExplicitWithFlagsR3_Flags[q29]
                  | q29 : int(1..fin1),
                    p_ExplicitWithFlagsR3_Values_Explicit[q29, 1] = p_ExplicitWithFlagsR3_Values_Explicit[q22, 1]])
             | q22 : int(1..fin1), p_ExplicitWithFlagsR3_Flags[q22] > 0]),
    and([a_ExplicitWithFlagsR2_Flags[q1 + 1] > 0 ->
         [toInt(a_ExplicitWithFlagsR2_Values_Occurrence[q1, q8]) | q8 : int(1..2)] <lex
         [toInt(a_ExplicitWithFlagsR2_Values_Occurrence[q1 + 1, q9]) | q9 : int(1..2)]
             | q1 : int(1..2)]),
    and([a_ExplicitWithFlagsR2_Flags[q2] = 0 ->
         and([a_ExplicitWithFlagsR2_Values_Occurrence[q2, q10] = false | q10 : int(1..2)])
             | q2 : int(1..3)]),
    and([a_ExplicitWithFlagsR2_Flags[q3 + 1] > 0 -> a_ExplicitWithFlagsR2_Flags[q3] > 0 | q3 : int(1..2)]),
    sum([a_ExplicitWithFlagsR2_Flags[q5] | q5 : int(1..3)]) <= 3,
    and([a_ExplicitWithFlagsR2_Flags[q6] > 0 ->
         1 = sum([toInt(a_ExplicitWithFlagsR2_Values_Occurrence[q6, q7]) | q7 : int(1..2)])
             | q6 : int(1..3)])

