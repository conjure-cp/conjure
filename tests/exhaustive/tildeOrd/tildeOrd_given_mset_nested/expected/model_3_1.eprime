language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithFlagsR3_Flags: matrix indexed by [int(1..fin1)] of int(0..fin1)
given p_ExplicitWithFlagsR3_Values_Explicit: matrix indexed by [int(1..fin1), int(1)] of int(1..2)
find a_ExplicitWithRepetitionR3_Flag: int(0..3)
find a_ExplicitWithRepetitionR3_Values_Explicit: matrix indexed by [int(1..3), int(1)] of int(1..2)
branching on [a_ExplicitWithRepetitionR3_Flag, a_ExplicitWithRepetitionR3_Values_Explicit]
such that
    and([q12 <= a_ExplicitWithRepetitionR3_Flag ->
         sum([toInt(q17 <= a_ExplicitWithRepetitionR3_Flag) *
              catchUndef(toInt(a_ExplicitWithRepetitionR3_Values_Explicit[q17, 1] =
                               a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1]),
                         0)
                  | q17 : int(1..3)])
         =
         sum([toInt(p_ExplicitWithFlagsR3_Values_Explicit[q13, 1] = a_ExplicitWithRepetitionR3_Values_Explicit[q12, 1])
              * catchUndef(p_ExplicitWithFlagsR3_Flags[q13], 0)
                  | q13 : int(1..fin1)])
             | q12 : int(1..3)]),
    and([sum([toInt(q25 <= a_ExplicitWithRepetitionR3_Flag) *
              catchUndef(toInt(a_ExplicitWithRepetitionR3_Values_Explicit[q25, 1] =
                               p_ExplicitWithFlagsR3_Values_Explicit[q20, 1]),
                         0)
                  | q25 : int(1..3)])
         =
         sum([p_ExplicitWithFlagsR3_Flags[q21]
                  | q21 : int(1..fin1),
                    p_ExplicitWithFlagsR3_Values_Explicit[q21, 1] = p_ExplicitWithFlagsR3_Values_Explicit[q20, 1]])
             | q20 : int(1..fin1), p_ExplicitWithFlagsR3_Flags[q20] > 0]),
    and([q1 + 1 <= a_ExplicitWithRepetitionR3_Flag ->
         -a_ExplicitWithRepetitionR3_Values_Explicit[q1, 1] <= -a_ExplicitWithRepetitionR3_Values_Explicit[q1 + 1, 1]
             | q1 : int(1..2)]),
    and([q2 > a_ExplicitWithRepetitionR3_Flag -> a_ExplicitWithRepetitionR3_Values_Explicit[q2, 1] = 1
             | q2 : int(1..3)]),
    a_ExplicitWithRepetitionR3_Flag <= 3

