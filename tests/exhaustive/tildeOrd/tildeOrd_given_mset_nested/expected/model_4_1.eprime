language ESSENCE' 1.0

given fin1: int
given p_ExplicitWithFlagsR3_Flags: matrix indexed by [int(1..fin1)] of int(0..fin1)
given p_ExplicitWithFlagsR3_Values_Explicit: matrix indexed by [int(1..fin1), int(1)] of int(1..2)
find a_ExplicitWithRepetitionR2_Flag: int(0..3)
find a_ExplicitWithRepetitionR2_Values_Occurrence: matrix indexed by [int(1..3), int(1..2)] of bool
branching on [a_ExplicitWithRepetitionR2_Flag, a_ExplicitWithRepetitionR2_Values_Occurrence]
such that
    and([q11 <= a_ExplicitWithRepetitionR2_Flag ->
         sum([toInt(q19 <= a_ExplicitWithRepetitionR2_Flag) *
              catchUndef(toInt(and([a_ExplicitWithRepetitionR2_Values_Occurrence[q19, q20] =
                                    a_ExplicitWithRepetitionR2_Values_Occurrence[q11, q20]
                                        | q20 : int(1..2)])),
                         0)
                  | q19 : int(1..3)])
         =
         sum([toInt(a_ExplicitWithRepetitionR2_Values_Occurrence[q11, p_ExplicitWithFlagsR3_Values_Explicit[q12, 1]] /\
                    and([a_ExplicitWithRepetitionR2_Values_Occurrence[q11, q15] ->
                         p_ExplicitWithFlagsR3_Values_Explicit[q12, 1] = q15
                             | q15 : int(1..2)]))
              * catchUndef(p_ExplicitWithFlagsR3_Flags[q12], 0)
                  | q12 : int(1..fin1)])
             | q11 : int(1..3)]),
    and([sum([toInt(q27 <= a_ExplicitWithRepetitionR2_Flag) *
              catchUndef(toInt(and([a_ExplicitWithRepetitionR2_Values_Occurrence[q27, q28] ->
                                    p_ExplicitWithFlagsR3_Values_Explicit[q22, 1] = q28
                                        | q28 : int(1..2)])
                               /\
                               a_ExplicitWithRepetitionR2_Values_Occurrence
                                   [q27, p_ExplicitWithFlagsR3_Values_Explicit[q22, 1]]),
                         0)
                  | q27 : int(1..3)])
         =
         sum([p_ExplicitWithFlagsR3_Flags[q23]
                  | q23 : int(1..fin1),
                    p_ExplicitWithFlagsR3_Values_Explicit[q23, 1] = p_ExplicitWithFlagsR3_Values_Explicit[q22, 1]])
             | q22 : int(1..fin1), p_ExplicitWithFlagsR3_Flags[q22] > 0]),
    and([q1 + 1 <= a_ExplicitWithRepetitionR2_Flag ->
         [toInt(a_ExplicitWithRepetitionR2_Values_Occurrence[q1, q7]) | q7 : int(1..2)] <=lex
         [toInt(a_ExplicitWithRepetitionR2_Values_Occurrence[q1 + 1, q8]) | q8 : int(1..2)]
             | q1 : int(1..2)]),
    and([q2 > a_ExplicitWithRepetitionR2_Flag ->
         and([a_ExplicitWithRepetitionR2_Values_Occurrence[q2, q9] = false | q9 : int(1..2)])
             | q2 : int(1..3)]),
    a_ExplicitWithRepetitionR2_Flag <= 3,
    and([q5 <= a_ExplicitWithRepetitionR2_Flag ->
         1 = sum([toInt(a_ExplicitWithRepetitionR2_Values_Occurrence[q5, q6]) | q6 : int(1..2)])
             | q5 : int(1..3)])

