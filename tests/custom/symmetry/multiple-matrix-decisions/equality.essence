language Essence 1.5
find x : matrix indexed by [int(1..3)] of int(0..1)
find checks : matrix indexed by [int(1..10)] of bool
such that
    checks[1] = ([x[i] | i : int(1..2)] = [x[j+1] | j : int(1..2)]),
    checks[2] = ([x[i] | i : int(1..2)] != [x[j+1] | j : int(1..2)]),
    checks[3] = ([x[2*i-1] | i : int(1..2)] = [x[j+1] | j : int(1..2)]),
    checks[4] = ([x[i] | i : int(1..2)] = [x[j] | j : int(1..3)]),
    checks[5] = ([x[i] | i : int(1..0)] = [x[j] | j : int(2..1)]),
    checks[6] = ([[x[i] + x[j] | j : int(1..2)] | i : int(1..2)] =
                 [[x[i+1] + x[j] | j : int(1..2)] | i : int(1..2)]),
    checks[7] = ([x[i] | i : int(2..3)] = [x[j] | j : int(1..2)]),
    checks[8] = ([x[i] | i : int(1,3)] = [x[j] | j : int(2..3)]),
    checks[9] = ([x[i] | i : int(2..3)] != [x[j] | j : int(1..2)]),
    checks[10] = ([[x[i] + x[j] | j : int(2..3)] | i : int(2..3)] =
                  [[x[i+1] + x[j+1] | j : int(1..2)] | i : int(1..2)])
