find f_Function1D: matrix indexed by [int(1..3)] of int(1..3)
find conjure_aux1_Function1D: matrix indexed by [int(1..numberOfSymmetries), int(1..3)] of int(1..3)
branching on [f_Function1D]
such that
    f_Function1D[1] = 1,
    and([and([elementId(symmetries_1_PermutationAsFunction_PermutationFunction_forwards_Function1D[q3, ..],
                        f_Function1D
                            [elementId(symmetries_1_PermutationAsFunction_PermutationFunction_backwards_Function1D
                                           [q3, ..],
                                       q8)])
              = conjure_aux1_Function1D[q3, q8]
                  | q8 : int(1..3)])
         /\
         and([conjure_aux1_Function1D
                  [q3,
                   elementId(symmetries_1_PermutationAsFunction_PermutationFunction_forwards_Function1D[q3, ..], q10)]
              =
              elementId(symmetries_1_PermutationAsFunction_PermutationFunction_forwards_Function1D[q3, ..],
                        f_Function1D[q10])
                  | q10 : int(1..3)])
             | q3 : int(1..numberOfSymmetries)]),
    and([[f_Function1D[q4] | q4 : int(1..3)] <=lex [conjure_aux1_Function1D[q3, q6] | q6 : int(1..3)]
             | q3 : int(1..numberOfSymmetries)])
