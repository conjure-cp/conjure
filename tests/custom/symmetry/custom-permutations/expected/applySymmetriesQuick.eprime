language ESSENCE' 1.0

given numberOfSymmetries: int(0..)
given symmetries_1_PermutationAsFunction_PermutationFunction_forwards_Function1D:
        matrix indexed by [int(1..numberOfSymmetries), int(1..3)] of int(1..3)
given symmetries_1_PermutationAsFunction_PermutationFunction_backwards_Function1D:
        matrix indexed by [int(1..numberOfSymmetries), int(1..3)] of int(1..3)
find f_Function1D: matrix indexed by [int(1..3)] of int(1..3)
branching on [f_Function1D]
such that
    f_Function1D[1] = 1,
    and([[f_Function1D[q4] | q4 : int(1..3)] <=lex
         [elementId(symmetries_1_PermutationAsFunction_PermutationFunction_forwards_Function1D[q3, ..],
                    f_Function1D
                        [elementId(symmetries_1_PermutationAsFunction_PermutationFunction_backwards_Function1D[q3, ..],
                                   q5)])
              | q5 : int(1..3)]
             | q3 : int(1..numberOfSymmetries)])
